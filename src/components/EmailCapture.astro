---
interface Props {
  variant?: "inline" | "banner";
  heading?: string;
  subheading?: string;
}

const {
  variant = "inline",
  heading = "Get the Free Vet Software Buyer's Guide",
  subheading = "Plus weekly tips on choosing and using practice management software. Join 1,000+ practice managers.",
} = Astro.props;
---

{variant === "banner" ? (
  <section class="bg-navy-900 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-bold text-white sm:text-3xl">
        {heading}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-base text-navy-300">
        {subheading}
      </p>
      <form action="#" method="POST" class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
        <label for="email-banner" class="sr-only">Email address</label>
        <input
          id="email-banner"
          name="email"
          type="email"
          required
          placeholder="you@yourpractice.com"
          autocomplete="email"
          class="flex-1 rounded-lg border border-navy-700 bg-navy-800 px-4 py-3 text-sm text-white placeholder-navy-400 transition-colors focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-accent-500 to-accent-600 px-6 py-3 text-sm font-semibold text-white transition-all duration-200 hover:from-accent-400 hover:to-accent-500 hover:shadow-lg hover:shadow-accent-500/25 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 focus:ring-offset-navy-900 active:scale-[0.98]"
        >
          Get the Guide
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l3.158-2.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </button>
      </form>
      <p class="mt-3 text-xs text-navy-400">
        No spam. Unsubscribe anytime.
      </p>
    </div>
  </section>
) : (
  <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8">
    <div class="text-center">
      <h3 class="font-heading text-xl font-bold text-navy-900 sm:text-2xl">
        {heading}
      </h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-navy-500">
        {subheading}
      </p>
    </div>
    <form action="#" method="POST" class="mx-auto mt-5 flex max-w-md flex-col gap-3 sm:flex-row">
      <label for="email-inline" class="sr-only">Email address</label>
      <input
        id="email-inline"
        name="email"
        type="email"
        required
        placeholder="you@yourpractice.com"
        autocomplete="email"
        class="flex-1 rounded-lg border border-navy-200 bg-white px-4 py-3 text-sm text-navy-800 placeholder-navy-400 transition-colors focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500"
      />
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-accent-500 to-accent-600 px-6 py-3 text-sm font-semibold text-white transition-all duration-200 hover:from-accent-400 hover:to-accent-500 hover:shadow-lg hover:shadow-accent-500/25 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 active:scale-[0.98]"
      >
        Get the Guide
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l3.158-2.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
        </svg>
      </button>
    </form>
    <p class="mt-3 text-center text-xs text-navy-400">
      No spam. Unsubscribe anytime.
    </p>
  </div>
)}
