---
interface Props {
  variant?: "dark" | "light" | "banner";
  heading?: string;
  subheading?: string;
}

const {
  variant = "dark",
  heading = "The Vet Software Briefing",
  subheading = "One email per week. The best deals, newest reviews, and unbiased picks — delivered to practice managers who care about making the right call.",
} = Astro.props;

const isDark = variant === "dark" || variant === "banner";
---

<div style={isDark
  ? "background:var(--navy-950); border-radius:var(--radius-lg); padding:3rem 2.5rem;"
  : "background:white; border:1px solid var(--stone-200); border-radius:var(--radius-lg); padding:2.5rem; box-shadow:var(--shadow-rest);"
}>
  <div style="max-width:520px; margin:0 auto; text-align:center;">
    <!-- Label -->
    <p class="section-label" style={isDark ? "color:var(--teal-400);" : ""}>
      Free Newsletter
    </p>

    <!-- Heading -->
    <h2 style={`font-family:var(--font-heading); font-size:1.625rem; font-weight:700; margin:0.5rem 0 0.75rem; line-height:1.2; color:${isDark ? "white" : "var(--navy-950)"};`}>
      {heading}
    </h2>

    <!-- Subheading -->
    <p style={`font-family:var(--font-body); font-size:0.9375rem; line-height:1.6; margin:0 0 1.75rem; color:${isDark ? "var(--navy-200)" : "var(--stone-500)"};`}>
      {subheading}
    </p>

    <!-- Form -->
    <form
      action="https://vet-softwares-newsletter.beehiiv.com/subscribe"
      method="GET"
      target="_blank"
      style="display:flex; gap:0.625rem; max-width:440px; margin:0 auto;"
    >
      <input
        type="email"
        name="email"
        required
        placeholder="your@email.com"
        style={`flex:1; font-family:var(--font-body); font-size:0.9375rem; padding:0.6875rem 1rem; border-radius:var(--radius-sm); border:1px solid ${isDark ? "var(--navy-700)" : "var(--stone-300)"}; background:${isDark ? "var(--navy-900)" : "white"}; color:${isDark ? "white" : "var(--stone-800)"}; outline:none;`}
      />
      <button type="submit" class="btn-primary" style="white-space:nowrap; flex-shrink:0;">
        Subscribe
      </button>
    </form>

    <p style={`font-family:var(--font-body); font-size:0.75rem; margin:0.875rem 0 0; color:${isDark ? "var(--navy-500)" : "var(--stone-400)"};`}>
      No spam. Unsubscribe anytime. ~5 minute read every week.
    </p>
  </div>
</div>
