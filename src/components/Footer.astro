---
const currentYear = new Date().getFullYear();
---

<footer style="background:var(--navy-950); color:var(--navy-100); margin-top:5rem;">

  <!-- Main Footer Grid -->
  <div class="container-wide" style="padding-top:3.5rem; padding-bottom:3rem;">
    <div style="display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:3rem;">

      <!-- Brand -->
      <div>
        <a href="/" style="display:inline-flex; align-items:center; gap:0.625rem; text-decoration:none; margin-bottom:1rem;">
          <div style="width:36px; height:36px; background:var(--teal-600); border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <span style="font-family:var(--font-heading); font-weight:700; font-size:0.9rem; color:white;">VS</span>
          </div>
          <span style="font-family:var(--font-heading); font-size:1.125rem; font-weight:700; color:white;">VetSoftwares</span>
        </a>
        <p style="font-family:var(--font-body); font-size:0.875rem; color:var(--navy-100); line-height:1.6; max-width:280px; margin:0 0 1.25rem;">
          Independent reviews and comparisons of veterinary practice management software. No vendor sponsorships. No bias.
        </p>
        <p style="font-family:var(--font-body); font-size:0.75rem; color:var(--navy-500); margin:0;">
          Trusted by 10,000+ practice managers
        </p>
      </div>

      <!-- Reviews -->
      <div>
        <h4 style="font-family:var(--font-body); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--teal-400); margin:0 0 1rem;">Reviews</h4>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.5rem;">
          {[
            ["Digitail", "/reviews/digitail"],
            ["ezyVet", "/reviews/ezyvet"],
            ["Shepherd", "/reviews/shepherd"],
            ["DaySmart Vet", "/reviews/daysmart-vet"],
            ["Vetspire", "/reviews/vetspire"],
            ["Hippo Manager", "/reviews/hippo-manager"],
          ].map(([name, href]) => (
            <li>
              <a href={href} style="font-family:var(--font-body); font-size:0.875rem; color:var(--navy-200); text-decoration:none; transition:color 0.15s;" class="footer-link">{name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Compare -->
      <div>
        <h4 style="font-family:var(--font-body); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--teal-400); margin:0 0 1rem;">Compare</h4>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.5rem;">
          {[
            ["Digitail vs ezyVet", "/compare/digitail-vs-ezyvet"],
            ["Digitail vs Shepherd", "/compare/digitail-vs-shepherd"],
            ["ezyVet vs Vetspire", "/compare/ezyvet-vs-vetspire"],
            ["Shepherd vs Hippo", "/compare/shepherd-vs-hippo-manager"],
            ["Best for Small Practices", "/best/best-veterinary-software-for-small-practices"],
            ["Best AI Software", "/best/best-veterinary-software-with-ai"],
          ].map(([name, href]) => (
            <li>
              <a href={href} style="font-family:var(--font-body); font-size:0.875rem; color:var(--navy-200); text-decoration:none;" class="footer-link">{name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 style="font-family:var(--font-body); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--teal-400); margin:0 0 1rem;">Resources</h4>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.5rem;">
          {[
            ["Revenue Calculator", "/tools/revenue-calculator"],
            ["Pricing Guide", "/guides/veterinary-software-pricing-guide"],
            ["How to Choose PIMS", "/guides/how-to-choose-veterinary-software"],
            ["Cloud vs Server", "/guides/cloud-vs-server-veterinary-software"],
            ["AI in Vet Software", "/guides/ai-in-veterinary-practice-management"],
          ].map(([name, href]) => (
            <li>
              <a href={href} style="font-family:var(--font-body); font-size:0.875rem; color:var(--navy-200); text-decoration:none;" class="footer-link">{name}</a>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom Bar -->
  <div style="border-top:1px solid var(--navy-800);">
    <div class="container-wide" style="display:flex; align-items:center; justify-content:space-between; padding-top:1.25rem; padding-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
      <p style="font-family:var(--font-body); font-size:0.8rem; color:var(--navy-500); margin:0;">
        &copy; {currentYear} VetSoftwares. All rights reserved. Made in Canada 🍁
      </p>
      <p style="font-family:var(--font-body); font-size:0.75rem; color:var(--navy-600); margin:0;">
        VetSoftwares earns commissions from affiliate links. Rankings are based on merit, not payments.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link:hover {
    color: var(--teal-400) !important;
  }

  @media (max-width: 768px) {
    footer > div:first-child > div > div {
      grid-template-columns: 1fr 1fr !important;
    }
  }

  @media (max-width: 480px) {
    footer > div:first-child > div > div {
      grid-template-columns: 1fr !important;
    }
  }
</style>
