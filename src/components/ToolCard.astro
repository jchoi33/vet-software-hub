---
import type { Tool } from "../utils/tools";
import { getAverageRating, getPricingDisplay, getAffiliateLink } from "../utils/tools";

interface Props {
  tool: Tool;
  rank?: number;
  badge?: string;
  showProsOnly?: boolean;
}

const { tool, rank, badge, showProsOnly = false } = Astro.props;

const avgRating = getAverageRating(tool);
const pricingDisplay = getPricingDisplay(tool);
const affiliateLink = getAffiliateLink(tool, `toolcard-${tool.slug}`, "card-cta");

// Star display helper
function getStars(rating: number | null): string {
  if (!rating) return "";
  const full = Math.floor(rating);
  const half = rating - full >= 0.5;
  const empty = 5 - full - (half ? 1 : 0);
  return "★".repeat(full) + (half ? "½" : "") + "☆".repeat(empty);
}
---

<article
  class="card card-lg"
  style="padding:1.5rem; position:relative; overflow:hidden;"
>
  <!-- Badge -->
  {badge && (
    <div style="position:absolute; top:0; right:0;">
      <div style="background:var(--teal-600); color:white; font-family:var(--font-body); font-size:0.7rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:0.3rem 0.875rem; border-radius:0 var(--radius-lg) 0 var(--radius-md);">
        {badge}
      </div>
    </div>
  )}

  <div style="display:grid; grid-template-columns:auto 1fr auto; gap:1.25rem; align-items:start;">

    <!-- Rank + Logo placeholder -->
    <div style="display:flex; flex-direction:column; align-items:center; gap:0.625rem;">
      {rank && (
        <div style="width:32px; height:32px; background:var(--navy-950); border-radius:50%; display:flex; align-items:center; justify-content:center;">
          <span style="font-family:var(--font-body); font-size:0.75rem; font-weight:700; color:white;">#{rank}</span>
        </div>
      )}
      <!-- Tool initial avatar -->
      <div style={`width:48px; height:48px; background:var(--navy-100); border-radius:10px; display:flex; align-items:center; justify-content:center; border:1px solid var(--navy-200);`}>
        <span style="font-family:var(--font-heading); font-size:1.125rem; font-weight:700; color:var(--navy-700);">
          {tool.name.charAt(0)}
        </span>
      </div>
    </div>

    <!-- Main content -->
    <div style="min-width:0;">
      <!-- Name + tagline -->
      <div style="margin-bottom:0.625rem;">
        <h3 style="font-family:var(--font-heading); font-size:1.125rem; font-weight:700; color:var(--navy-950); margin:0 0 0.2rem; padding-right:4rem;">
          <a href={`/reviews/${tool.slug}`} style="text-decoration:none; color:inherit;">{tool.name}</a>
        </h3>
        <p style="font-family:var(--font-body); font-size:0.8125rem; color:var(--stone-500); margin:0; font-style:italic;">
          {tool.tagline}
        </p>
      </div>

      <!-- Ratings -->
      {avgRating && (
        <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
          <span style="color:var(--amber-500); font-size:0.875rem; letter-spacing:0.02em;">{getStars(avgRating)}</span>
          <span style="font-family:var(--font-mono); font-size:0.8125rem; font-weight:600; color:var(--stone-700);">{avgRating.toFixed(1)}</span>
          <span style="font-family:var(--font-body); font-size:0.75rem; color:var(--stone-400);">({tool.review_count_approx}+ reviews)</span>
        </div>
      )}

      <!-- Best For tags -->
      <div style="display:flex; flex-wrap:wrap; gap:0.375rem; margin-bottom:0.875rem;">
        {tool.best_for.slice(0, 3).map((tag) => (
          <span class="feature-tag">{tag}</span>
        ))}
      </div>

      <!-- Top features -->
      <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.3rem;">
        {tool.key_features.slice(0, 3).map((feature) => (
          <li style="display:flex; align-items:center; gap:0.375rem; font-family:var(--font-body); font-size:0.8125rem; color:var(--stone-600);">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" style="width:13px;height:13px;color:var(--teal-500);flex-shrink:0;" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 01.208 1.04l-5 7.5a.75.75 0 01-1.154.114l-3-3a.75.75 0 011.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 011.04-.207z" clip-rule="evenodd" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>
    </div>

    <!-- Pricing + CTA column -->
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.75rem; min-width:140px; text-align:right;">
      <!-- Price -->
      <div>
        <div style="font-family:var(--font-mono); font-size:1.125rem; font-weight:600; color:var(--navy-900);">
          {tool.starting_price_monthly !== null ? `$${tool.starting_price_monthly}` : "Custom"}
        </div>
        <div style="font-family:var(--font-body); font-size:0.72rem; color:var(--stone-400);">
          {tool.starting_price_monthly !== null ? "per month" : "pricing"}
        </div>
      </div>

      <!-- Free trial badge -->
      {tool.free_trial && (
        <div style="background:var(--teal-50); border:1px solid var(--teal-200); border-radius:6px; padding:0.2rem 0.5rem;">
          <span style="font-family:var(--font-body); font-size:0.7rem; font-weight:600; color:var(--teal-700);">Free Trial</span>
        </div>
      )}

      <!-- Buttons -->
      <div style="display:flex; flex-direction:column; gap:0.5rem; width:100%;">
        <a
          href={affiliateLink}
          target="_blank"
          rel="nofollow noopener sponsored"
          class="btn-primary"
          style="font-size:0.8125rem; padding:0.5rem 1rem; justify-content:center;"
        >
          Visit {tool.name.split(" ")[0]}
        </a>
        <a
          href={`/reviews/${tool.slug}`}
          style="font-family:var(--font-body); font-size:0.8rem; color:var(--teal-600); text-decoration:none; text-align:center;"
        >
          Read Full Review →
        </a>
      </div>
    </div>

  </div>
</article>

<style>
  article.card {
    transition: box-shadow var(--transition-smooth), transform var(--transition-smooth), border-color var(--transition-smooth);
  }

  @media (max-width: 640px) {
    article.card > div {
      grid-template-columns: 1fr !important;
      gap: 1rem !important;
    }
    article.card > div > div:last-child {
      align-items: flex-start !important;
      text-align: left !important;
      flex-direction: row !important;
      flex-wrap: wrap !important;
    }
  }
</style>
