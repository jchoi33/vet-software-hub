---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  schema?: Record<string, unknown>;
  toolAName: string;
  toolBName: string;
  lastUpdated: string;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  schema,
  toolAName,
  toolBName,
  lastUpdated,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType="article"
  schema={schema}
>
  <article class="mx-auto max-w-5xl px-4 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-6 text-sm" aria-label="Breadcrumb" style="color:#78716c;">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" style="color:#466c34; text-decoration:none;" onmouseover="this.style.color='#344a2b';" onmouseout="this.style.color='#466c34';">Home</a></li>
        <li style="color:#a8a29e;">·</li>
        <li><a href="/compare" style="color:#466c34; text-decoration:none;" onmouseover="this.style.color='#344a2b';" onmouseout="this.style.color='#466c34';">Compare</a></li>
        <li style="color:#a8a29e;">·</li>
        <li style="color:#292524; font-weight:600;">{toolAName} vs {toolBName}</li>
      </ol>
    </nav>

    <p class="mb-2 text-xs" style="color:#a8a29e;">
      Last updated: <time>{lastUpdated}</time>
    </p>

    <slot />
  </article>
</BaseLayout>
