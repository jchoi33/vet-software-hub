  return Object.keys(usecaseConfigs).map((usecase) => ({
    params: { usecase },
    props: { config: usecaseConfigs[usecase] },
  }));
}

interface Props {
  config: UseCaseConfig;
}

const { usecase } = Astro.params;
const { config } = Astro.props;

const meta = getBestForMeta(usecase, config.displayName);

// Resolve tool objects for each pick
const picks = config.picks
  .map((p) => {
    const tool = getToolBySlug(p.slug);
    return tool ? { tool, whyPick: p.whyPick, rank: p.rank } : null;
  })
  .filter((p): p is { tool: Tool; whyPick: string; rank: number } => p !== null)
  .sort((a, b) => a.rank - b.rank);

// Build comparison table from top picks (first 2)
const comparisonPair = picks.length >= 2 ? [picks[0].tool, picks[1].tool] : null;

// Pre-build FAQ schema JSON
const faqSchemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: config.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
});
