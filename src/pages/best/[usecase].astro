    </p>

    <!-- Quick Picks Summary -->
    <div class="mt-8 rounded-xl border border-accent-200 bg-accent-50/30 p-6">
      <h2 class="font-heading text-lg font-bold text-navy-900">Our Top Picks at a Glance</h2>
      <ol class="mt-4 space-y-3">
        {picks.map((pick) => (
          <li class="flex items-start gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-500 text-sm font-bold text-white">
              {pick.rank}
            </span>
            <div>
              <a
                href={`/reviews/${pick.tool.slug}`}
                class="font-heading font-bold text-navy-900 hover:text-accent-600 transition-colors"
              >
                {pick.tool.name}
              </a>
              <span class="ml-2 text-sm text-navy-500">{getPricingDisplay(pick.tool)}</span>
              {pick.tool.free_trial && (
                <span class="ml-2 inline-block rounded-full bg-accent-100 px-2 py-0.5 text-xs font-semibold text-accent-700">
                  Free Trial
                </span>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Methodology -->
    <section class="mt-12">
      <h2 class="font-heading text-2xl font-bold text-navy-900">How We Evaluated</h2>
      <p class="mt-3 leading-relaxed text-navy-600">{config.methodology}</p>
    </section>

    <!-- Detailed Reviews of Each Pick -->
    <section class="mt-12">
      <h2 class="font-heading text-2xl font-bold text-navy-900">
        Top {picks.length} Veterinary Software for {config.displayName}
      </h2>
      <div class="mt-8 space-y-10">
        {picks.map((pick) => (
          <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm sm:p-8">
            <!-- Header -->
            <div class="flex items-start justify-between gap-4 flex-col sm:flex-row">
              <div>
                <div class="flex items-center gap-3">
                  <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent-100 text-sm font-bold text-accent-700">
                    #{pick.rank}
                  </span>
                  <h3 class="font-heading text-2xl font-bold text-navy-900">
                    {pick.tool.name}
                  </h3>
                </div>
                <p class="mt-1 text-sm text-navy-500">{pick.tool.tagline}</p>
              </div>
              <div class="flex flex-col items-start gap-2 sm:items-end shrink-0">
                <span class="font-heading text-xl font-bold text-navy-900">
                  {getPricingDisplay(pick.tool)}
                </span>
                {pick.tool.free_trial && (
                  <span class="text-xs font-medium text-accent-600">Free trial available</span>
                )}
              </div>
            </div>

            <!-- Why We Picked It -->
            <div class="mt-5 rounded-lg border border-accent-100 bg-accent-50/30 px-5 py-4">
              <p class="text-sm font-semibold uppercase tracking-wider text-accent-700">
                Why it's our #{pick.rank} pick
              </p>
              <p class="mt-2 text-sm leading-relaxed text-navy-600">{pick.whyPick}</p>
            </div>

            <!-- Pros -->
            <div class="mt-5">
              <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-navy-400">
                Key Strengths
              </h4>
              <ul class="space-y-1">
                {pick.tool.pros.slice(0, 3).map((pro) => (
                  <li class="flex items-start gap-2 text-sm text-navy-700">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="mt-0.5 h-4 w-4 shrink-0 text-accent-500"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- CTAs -->
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
              <AffiliateButton
                href={getAffiliateLink(pick.tool, `best-${usecase}`, `pick-${pick.rank}`)}
                label={`Visit ${pick.tool.name}`}
                tool={pick.tool.name}
                size="md"
              />
              <a
                href={`/reviews/${pick.tool.slug}`}
                class="text-sm font-medium text-accent-600 underline decoration-accent-200 underline-offset-2 hover:text-accent-700 transition-colors"
              >
                Read full {pick.tool.name} review →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Comparison Table (top 2) -->
    {comparisonPair && (
      <section class="mt-14">
        <h2 class="font-heading text-2xl font-bold text-navy-900">
          {picks[0].tool.name} vs {picks[1].tool.name}: Quick Comparison
        </h2>
        <div class="mt-6">
          <ComparisonTable toolA={comparisonPair[0]} toolB={comparisonPair[1]} />
        </div>
        <p class="mt-3 text-xs text-navy-400">
          See our{" "}
          <a
            href={`/compare/${picks[0].tool.slug}-vs-${picks[1].tool.slug}`}
            class="text-accent-600 underline decoration-accent-200 underline-offset-2 hover:text-accent-700"
          >
            full {picks[0].tool.name} vs {picks[1].tool.name} comparison
          </a>{" "}
          for a deeper breakdown.
        </p>
      </section>
    )}

    <!-- How to Choose -->
    <section class="mt-14">
      <h2 class="font-heading text-2xl font-bold text-navy-900">
        How to Choose the Right Software for {config.displayName}
      </h2>
      <ul class="mt-6 space-y-4">
        {config.howToChoose.map((tip, i) => (
          <li class="flex items-start gap-4 rounded-lg border border-navy-100 bg-white p-5">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-navy-100 text-sm font-bold text-navy-700">
              {i + 1}
            </div>
            <p class="text-sm leading-relaxed text-navy-600">{tip}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Email Capture -->
    <section class="mt-14">
      <EmailCapture
        heading="Get Our Free Vet Software Buyer's Guide"
        subheading={`Includes our full analysis of every tool on this list plus 15+ more. Join 1,000+ practice managers making smarter software decisions.`}
      />
    </section>

    <!-- FAQ -->
    <section class="mt-14">
      <h2 class="font-heading text-2xl font-bold text-navy-900">
        Frequently Asked Questions
      </h2>
      <div class="mt-6 space-y-3">
        {config.faqs.map((faq) => (
          <details class="group rounded-lg border border-navy-100 bg-white">
            <summary class="flex cursor-pointer items-center justify-between p-5 font-heading font-semibold text-navy-800 transition-colors hover:text-accent-600">
              <span>{faq.question}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-5 w-5 shrink-0 text-navy-400 transition-transform group-open:rotate-180"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </summary>
            <div class="border-t border-navy-100 px-5 py-4 text-sm leading-relaxed text-navy-600">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related Links -->
    <nav class="mt-14 rounded-xl border border-navy-100 bg-white p-6" aria-label="Related content">
      <h3 class="font-heading text-lg font-bold text-navy-900">Related Pages</h3>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {picks.slice(0, 4).map((pick) => (
          <li>
            <a
              href={`/reviews/${pick.tool.slug}`}
              class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400"
            >
              {pick.tool.name} Full Review
            </a>
          </li>
        ))}
        {picks.length >= 2 && (
          <li>
            <a
              href={`/compare/${picks[0].tool.slug}-vs-${picks[1].tool.slug}`}
              class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400"
            >
              {picks[0].tool.name} vs {picks[1].tool.name}
            </a>
          </li>
        )}
      </ul>
    </nav>

    <!-- FAQ Schema -->
    <script type="application/ld+json" set:html={faqSchemaJson} />
  </article>
</BaseLayout>
