---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CategoryCard from "../../components/CategoryCard.astro";

// Hardcoded list — mirrors exact slugs in best/[usecase].astro getStaticPaths
const bestForPages = [
  {
    slug: "best-veterinary-software-for-small-practices",
    emoji: "🐾",
    title: "Best for Small Practices",
    description: "1–3 vets, tight budget, need something simple that just works.",
    count: "4 picks",
  },
  {
    slug: "best-veterinary-software-for-large-hospitals",
    emoji: "🏥",
    title: "Best for Large Hospitals",
    description: "Multi-doctor, high volume, complex scheduling and billing.",
    count: "4 picks",
  },
  {
    slug: "best-free-veterinary-software",
    emoji: "🆓",
    title: "Best Free Vet Software",
    description: "Zero or near-zero cost options for budget-conscious practices.",
    count: "3 picks",
  },
  {
    slug: "best-veterinary-software-with-ai",
    emoji: "🤖",
    title: "Best AI Vet Software",
    description: "AI SOAP notes, smart charge capture, and automation-first workflows.",
    count: "3 picks",
  },
  {
    slug: "best-cloud-based-veterinary-software",
    emoji: "☁️",
    title: "Best Cloud-Based",
    description: "Work from anywhere. No server maintenance. Automatic updates.",
    count: "4 picks",
  },
  {
    slug: "best-veterinary-software-for-multi-location",
    emoji: "📍",
    title: "Best for Multi-Location",
    description: "Centralized billing, shared inventory, consolidated reporting.",
    count: "4 picks",
  },
  {
    slug: "best-veterinary-software-for-startups",
    emoji: "🚀",
    title: "Best for Startups",
    description: "Opening a new practice? Start here. Low upfront, scales fast.",
    count: "4 picks",
  },
  {
    slug: "best-veterinary-software-for-equine-practices",
    emoji: "🐴",
    title: "Best for Equine Practices",
    description: "Large animal, field work, farm records, and barn billing.",
    count: "3 picks",
  },
  {
    slug: "best-veterinary-software-for-mobile-vets",
    emoji: "🚐",
    title: "Best for Mobile Vets",
    description: "Tablet-optimized, field-friendly, works offline when needed.",
    count: "3 picks",
  },
  {
    slug: "best-veterinary-software-for-emergency-clinics",
    emoji: "🚨",
    title: "Best for Emergency Clinics",
    description: "24/7 workflows, whiteboard, triage tools, and fast data entry.",
    count: "3 picks",
  },
  {
    slug: "best-veterinary-software-for-specialty-clinics",
    emoji: "🔬",
    title: "Best for Specialty Clinics",
    description: "Referral management, clinical decision support, advanced diagnostics.",
    count: "2 picks",
  },
  {
    slug: "best-veterinary-software-for-client-communication",
    emoji: "💬",
    title: "Best for Client Communication",
    description: "Two-way texting, automated reminders, and pet parent apps.",
    count: "4 picks",
  },
  {
    slug: "best-veterinary-software-for-inventory-management",
    emoji: "📦",
    title: "Best for Inventory",
    description: "Auto-reordering, controlled substances tracking, shrinkage reports.",
    count: "4 picks",
  },
  {
    slug: "best-veterinary-software-for-telemedicine",
    emoji: "📱",
    title: "Best for Telemedicine",
    description: "Native video consults with built-in billing and SOAP integration.",
    count: "3 picks",
  },
  {
    slug: "best-veterinary-software-for-mixed-practice",
    emoji: "🐄",
    title: "Best for Mixed Practice",
    description: "Small animal and large animal in one unified platform.",
    count: "3 picks",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Best Veterinary Software by Category",
  description: "Find the right veterinary PIMS for your practice type. 15 independently researched best-for categories.",
  url: "https://vetsoftwares.com/best",
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://vetsoftwares.com" },
      { "@type": "ListItem", position: 2, name: "Best For", item: "https://vetsoftwares.com/best" },
    ],
  },
};
---

<BaseLayout
  title="Best Veterinary Practice Management Software 2026 — By Category | VetSoftwares"
  description="Find the right veterinary PIMS for your practice. Browse 15 best-for categories: small practices, large hospitals, AI features, mobile vets, emergency clinics, and more."
  canonical="https://vetsoftwares.com/best"
  schema={schema}
>

  <!-- ═══ PAGE BANNER ═══ -->
  <section style="background:#1a2416; border-bottom:1px solid #2d3d26; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:2rem; padding-bottom:2rem;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap;">

        <!-- Left: breadcrumb + title + subtitle -->
        <div style="flex:1; min-width:0;">
          <nav style="margin-bottom:0.625rem;">
            <ol style="display:inline-flex; align-items:center; gap:0.4rem; list-style:none; padding:0; margin:0; font-family:var(--font-body); font-size:0.75rem; color:#5a7a4a;">
              <li><a href="/" style="color:#5a7a4a; text-decoration:none; transition:color 0.15s;" onmouseover="this.style.color='#9aba82';" onmouseout="this.style.color='#5a7a4a';">Home</a></li>
              <li style="color:#3a4f34;">/</li>
              <li style="color:#c4d5b7; font-weight:600;">Best For</li>
            </ol>
          </nav>
          <h1 style="font-family:var(--font-heading); font-size:clamp(1.375rem,3vw,1.875rem); font-weight:800; color:white; line-height:1.2; margin:0 0 0.5rem;">
            Best Veterinary Software For...
          </h1>
          <p style="font-family:var(--font-body); font-size:0.9375rem; color:#8aab72; line-height:1.6; margin:0; max-width:520px;">
            Find the right PIMS for your practice type, size, and workflow. 15 independently researched categories.
          </p>
        </div>

        <!-- Right: stats -->
        <div style="display:flex; gap:0.75rem; flex-shrink:0; flex-wrap:wrap;">
          {[
            { stat: "15", label: "Categories" },
            { stat: "25", label: "Tools Evaluated" },
            { stat: "2026", label: "Data Current" },
          ].map((item) => (
            <div style="background:rgba(255,255,255,0.05); border:1px solid #2d3d26; border-radius:10px; padding:0.625rem 1rem; text-align:center; min-width:90px;">
              <div style="font-family:var(--font-mono); font-size:1.25rem; font-weight:700; color:#fbbf24; line-height:1;">{item.stat}</div>
              <div style="font-family:var(--font-body); font-size:0.68rem; color:#5a7a4a; margin-top:0.2rem; font-weight:500; text-transform:uppercase; letter-spacing:0.04em;">{item.label}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ CATEGORY GRID ═══ -->
  <section style="background:#f5f5f4; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:4rem; padding-bottom:4.5rem;">

      <SectionHeader
        label="Browse Categories"
        title="Find Your Fit"
        subtitle="Pick the category that matches your practice. Each guide includes ranked picks, comparison tables, and honest verdicts."
        align="center"
      />

      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:1rem; margin-top:2.5rem;">
        {bestForPages.map((page) => (
          <CategoryCard
            href={"/best/" + page.slug}
            emoji={page.emoji}
            title={page.title}
            description={page.description}
            count={page.count}
          />
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ NOT SURE CTA ═══ -->
  <section class="container-wide" style="padding-top:3.5rem; padding-bottom:3.5rem;">
    <div style="background:linear-gradient(135deg,#0a1628 0%,#1e3d6f 100%); border-radius:16px; padding:2.5rem 2rem; display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center;">
      <div>
        <div style="font-family:var(--font-body); font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#2dd4bf; margin-bottom:0.75rem;">Free Tool</div>
        <h2 style="font-family:var(--font-heading); font-size:clamp(1.25rem,2.5vw,1.75rem); font-weight:700; color:white; margin:0 0 0.625rem;">Not sure which category fits?</h2>
        <p style="font-family:var(--font-body); font-size:0.9375rem; color:#b9d0ef; margin:0; line-height:1.65;">Get personalized software recommendations based on your practice size, no-show rate, and budget.</p>
      </div>
      <div style="flex-shrink:0;">
        <a href="/tools/revenue-calculator" class="btn-primary" style="white-space:nowrap; padding:0.875rem 1.5rem; font-size:0.9rem;">
          Try the Calculator →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section style="margin:0 -1.5rem; padding:0 1.5rem;">
    <EmailCapture variant="dark" />
  </section>

</BaseLayout>

<style>
  @media (max-width: 640px) {
    div[style*="grid-template-columns:1fr auto"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
