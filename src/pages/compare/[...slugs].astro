---

<ComparisonLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  schema={meta.schema}
  toolAName={toolA.name}
  toolBName={toolB.name}
  lastUpdated="February 25, 2026"
>
  <!-- Affiliate Disclosure -->
  <div class="mb-8 rounded-lg border border-navy-100 bg-navy-50/50 px-4 py-3 text-xs text-navy-500">
    <strong>Disclosure:</strong> VetSoftwareHub is reader-supported. When you click our affiliate links and make a purchase, we may earn a commission at no extra cost to you. We independently evaluate every product. Our opinions are our own.
  </div>

  <!-- H1 Title -->
  <h1 class="font-heading text-3xl font-bold text-navy-900 sm:text-4xl">
    {toolA.name} vs {toolB.name}: Which Veterinary Software Is Better in 2026?
  </h1>
  <p class="mt-4 text-lg text-navy-500">
    We compared {toolA.name} and {toolB.name} across pricing, features, ratings, and real-world fit to help you make the right choice for your veterinary practice.
  </p>

  <!-- ============================================================ -->
  <!-- Section 1: Quick Comparison Summary                          -->
  <!-- ============================================================ -->
  <div class="mt-10 rounded-xl border border-navy-100 bg-white shadow-sm">
    <div class="grid grid-cols-1 divide-y divide-navy-100 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <!-- Tool A Summary -->
      <div class="flex flex-col items-center p-6 text-center">
        <h3 class="font-heading text-lg font-bold text-navy-900">{toolA.name}</h3>
        <div class="mt-3">
          <RatingStars rating={ratingA} />
        </div>
        <p class="mt-2 text-sm font-semibold text-navy-700">{priceA}</p>
        <p class="mt-1 text-xs text-navy-400">{toolA.deployment}</p>
      </div>

      <!-- VS Badge -->
      <div class="flex flex-col items-center justify-center p-6 text-center">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-navy-900 font-heading text-sm font-bold text-white">
          VS
        </span>
      </div>

      <!-- Tool B Summary -->
      <div class="flex flex-col items-center p-6 text-center">
        <h3 class="font-heading text-lg font-bold text-navy-900">{toolB.name}</h3>
        <div class="mt-3">
          <RatingStars rating={ratingB} />
        </div>
        <p class="mt-2 text-sm font-semibold text-navy-700">{priceB}</p>
        <p class="mt-1 text-xs text-navy-400">{toolB.deployment}</p>
      </div>
    </div>

    <!-- Quick Verdict -->
    <div class="border-t border-navy-100 px-6 py-5">
      <h4 class="font-heading text-sm font-bold uppercase tracking-wide text-navy-400">Quick Verdict</h4>
      <p class="mt-2 text-sm leading-relaxed text-navy-700">{quickVerdict}</p>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- Section 2: Comparison Table                                   -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">{toolA.name} vs {toolB.name} at a Glance</h2>
    <div class="mt-6">
      <ComparisonTable toolA={toolA} toolB={toolB} />
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Section 3: Overview of Both Tools                             -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">Overview of Both Tools</h2>

    <div class="mt-6 space-y-6">
      <div>
        <h3 class="font-heading text-xl font-semibold text-navy-800">{toolA.name}</h3>
        <p class="mt-2 text-navy-500 leading-relaxed">
          {toolA.name} is a {toolA.deployment.toLowerCase()} veterinary practice management platform founded in {toolA.founded} and headquartered in {toolA.hq}. Marketed as "{toolA.tagline.toLowerCase()}", it serves {toolA.users_approx.toLowerCase()} and is best suited for {toolA.best_for.map((b) => b.toLowerCase()).join(", ")}. The platform supports {toolA.practice_types.join(", ")} practice types.
        </p>
      </div>

      <div>
        <h3 class="font-heading text-xl font-semibold text-navy-800">{toolB.name}</h3>
        <p class="mt-2 text-navy-500 leading-relaxed">
          {toolB.name} is a {toolB.deployment.toLowerCase()} veterinary software solution founded in {toolB.founded} and headquartered in {toolB.hq}. Described as "{toolB.tagline.toLowerCase()}", it serves {toolB.users_approx.toLowerCase()} and is best suited for {toolB.best_for.map((b) => b.toLowerCase()).join(", ")}. It supports {toolB.practice_types.join(", ")} practice types.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Section 4: Feature-by-Feature Comparison                      -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">Feature-by-Feature Comparison</h2>
    <p class="mt-2 text-navy-500">
      We evaluated {toolA.name} and {toolB.name} across six key areas that matter most to veterinary practices.
    </p>

    <div class="mt-8 space-y-8">
      {currentFeatureAreas.map((area) => (
        <div class="rounded-lg border border-navy-100 bg-white p-6">
          <div class="flex items-center justify-between">
            <h3 class="font-heading text-lg font-semibold text-navy-800">{area.title}</h3>
            <span
              class:list={[
                "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold",
                area.edge === "a" && "bg-accent-50 text-accent-700",
                area.edge === "b" && "bg-blue-50 text-blue-700",
                area.edge === "tie" && "bg-navy-50 text-navy-600",
              ]}
            >
              {area.edge === "a" ? `${toolA.name} wins` : area.edge === "b" ? `${toolB.name} wins` : "Tie"}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-navy-500">{area.analysis}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Section 5: Pricing Comparison                                 -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">Pricing Comparison</h2>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {[toolA, toolB].map((tool) => (
        <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
          <h3 class="font-heading text-lg font-bold text-navy-900">{tool.name}</h3>
          <dl class="mt-4 space-y-3">
            <div class="flex justify-between border-b border-navy-50 pb-2">
              <dt class="text-sm text-navy-500">Starting Price</dt>
              <dd class="text-sm font-semibold text-navy-800">{getPricingDisplay(tool)}</dd>
            </div>
            <div class="flex justify-between border-b border-navy-50 pb-2">
              <dt class="text-sm text-navy-500">Pricing Model</dt>
              <dd class="text-sm text-navy-800">{tool.pricing_model}</dd>
            </div>
            <div class="flex justify-between border-b border-navy-50 pb-2">
              <dt class="text-sm text-navy-500">Free Trial</dt>
              <dd class:list={["text-sm font-semibold", tool.free_trial ? "text-accent-600" : "text-navy-400"]}>
                {tool.free_trial ? "Yes" : "No"}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-navy-500">Free Plan</dt>
              <dd class:list={["text-sm font-semibold", tool.free_plan ? "text-accent-600" : "text-navy-400"]}>
                {tool.free_plan ? "Yes" : "No"}
              </dd>
            </div>
          </dl>
        </div>
      ))}
    </div>

    <p class="mt-4 text-sm text-navy-400">
      Prices shown are published starting rates. Actual pricing may vary based on practice size, contract length, and negotiation. Contact each vendor for a personalized quote.
    </p>
  </section>

  <!-- ============================================================ -->
  <!-- Section 6: User Ratings Comparison                            -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">User Ratings Comparison</h2>
    <p class="mt-2 text-sm text-navy-500">
      Aggregate ratings from G2 and Capterra, the two leading B2B software review platforms.
    </p>

    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {[toolA, toolB].map((tool) => (
        <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
          <h3 class="font-heading text-lg font-bold text-navy-900">{tool.name}</h3>
          <div class="mt-4 space-y-4">
            <div>
              <p class="mb-1 text-xs font-medium uppercase tracking-wide text-navy-400">G2 Rating</p>
              <RatingStars rating={tool.rating_g2} />
            </div>
            <div>
              <p class="mb-1 text-xs font-medium uppercase tracking-wide text-navy-400">Capterra Rating</p>
              <RatingStars rating={tool.rating_capterra} />
            </div>
            <p class="text-xs text-navy-400">Based on approximately {tool.review_count_approx} reviews</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Section 7: Who Should Choose Tool A?                          -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">Who Should Choose {toolA.name}?</h2>
    <div class="mt-4">
      <p class="text-navy-500 leading-relaxed">
        Based on our analysis, {toolA.name} is the right choice if your practice matches any of the following profiles:
      </p>
      <ul class="mt-4 space-y-2">
        {toolA.best_for.map((useCase) => (
          <li class="flex items-start gap-2 text-sm text-navy-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>{useCase}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-6">
      <h3 class="font-heading text-lg font-semibold text-navy-800">{toolA.name} Strengths</h3>
      <div class="mt-3">
        <ProsCons pros={toolA.pros} cons={toolA.cons} />
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Section 8: Who Should Choose Tool B?                          -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">Who Should Choose {toolB.name}?</h2>
    <div class="mt-4">
      <p class="text-navy-500 leading-relaxed">
        Based on our analysis, {toolB.name} is the right choice if your practice matches any of the following profiles:
      </p>
      <ul class="mt-4 space-y-2">
        {toolB.best_for.map((useCase) => (
          <li class="flex items-start gap-2 text-sm text-navy-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>{useCase}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-6">
      <h3 class="font-heading text-lg font-semibold text-navy-800">{toolB.name} Strengths</h3>
      <div class="mt-3">
        <ProsCons pros={toolB.pros} cons={toolB.cons} />
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Section 9: Our Recommendation                                 -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">Our Recommendation</h2>
    <div class="mt-4 rounded-xl border-2 border-accent-200 bg-accent-50/30 p-6 sm:p-8">
      <p class="text-navy-700 leading-relaxed">{recommendation}</p>

      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
        <AffiliateButton
          href={toolA.website}
          label={`Try ${toolA.name}`}
          tool={toolA.name}
          size="md"
        />
        <AffiliateButton
          href={toolB.website}
          label={`Try ${toolB.name}`}
          tool={toolB.name}
          size="md"
        />
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Section 10: FAQ                                               -->
  <!-- ============================================================ -->
  <section class="mt-14">
    <h2 class="font-heading text-2xl font-bold text-navy-900">Frequently Asked Questions</h2>

    <div class="mt-6 space-y-3">
      {currentFAQs.map((faq) => (
        <details class="group rounded-lg border border-navy-100 bg-white">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 font-heading text-sm font-semibold text-navy-800 transition-colors hover:text-accent-600">
            <span>{faq.question}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5 shrink-0 text-navy-400 transition-transform group-open:rotate-180"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="border-t border-navy-100 px-5 py-4">
            <p class="text-sm leading-relaxed text-navy-500">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Email Capture                                                 -->
  <!-- ============================================================ -->
  <div class="mt-14">
    <EmailCapture
      heading="Get the Free Vet Software Buyer's Guide"
      subheading={`Still deciding between ${toolA.name} and ${toolB.name}? Our buyer's guide covers all 20+ tools with pricing, feature comparisons, and our top picks.`}
    />
  </div>

  <!-- ============================================================ -->
  <!-- Internal Links                                                -->
  <!-- ============================================================ -->
  <nav class="mt-14 rounded-xl border border-navy-100 bg-white p-6" aria-label="Related content">
    <h3 class="font-heading text-lg font-bold text-navy-900">Related Comparisons & Reviews</h3>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      <li>
        <a href={`/reviews/${toolA.slug}`} class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400">
          {toolA.name} Full Review
        </a>
      </li>
      <li>
        <a href={`/reviews/${toolB.slug}`} class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400">
          {toolB.name} Full Review
        </a>
      </li>
      <li>
        <a href={`/alternatives/${toolA.slug}`} class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400">
          {toolA.name} Alternatives
        </a>
      </li>
      <li>
        <a href={`/alternatives/${toolB.slug}`} class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400">
          {toolB.name} Alternatives
        </a>
      </li>
      <li>
        <a href={`/pricing/${toolA.slug}`} class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400">
          {toolA.name} Pricing Breakdown
        </a>
      </li>
      <li>
        <a href={`/pricing/${toolB.slug}`} class="text-sm text-accent-600 underline decoration-accent-200 underline-offset-2 transition-colors hover:text-accent-700 hover:decoration-accent-400">
          {toolB.name} Pricing Breakdown
        </a>
      </li>
    </ul>
  </nav>
</ComparisonLayout>
