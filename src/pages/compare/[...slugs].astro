---
import ComparisonLayout from "../../layouts/ComparisonLayout.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import ProsCons from "../../components/ProsCons.astro";
import AffiliateButton from "../../components/AffiliateButton.astro";
import RatingStars from "../../components/RatingStars.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import { getToolBySlug, getAverageRating, getAffiliateLink, getPricingDisplay } from "../../utils/tools";
import type { Tool } from "../../utils/tools";
import { getComparisonMeta } from "../../utils/seo";

export function getStaticPaths() {
  const pairs = [
    ['digitail', 'ezyvet'],
    ['digitail', 'shepherd'],
    ['ezyvet', 'vetspire'],
    ['daysmart-vet', 'hippo-manager'],
    ['shepherd', 'vetbadger'],
  ];

  return pairs.map(([slugA, slugB]) => {
    const toolA = getToolBySlug(slugA)!;
    const toolB = getToolBySlug(slugB)!;
    return {
      params: { slugs: `${slugA}-vs-${slugB}` },
      props: { toolA, toolB },
    };
  });
}

interface Props {
  toolA: Tool;
  toolB: Tool;
}

const { toolA, toolB } = Astro.props;
const meta = getComparisonMeta(toolA, toolB);
const ratingA = getAverageRating(toolA);
const ratingB = getAverageRating(toolB);
const priceA = getPricingDisplay(toolA);
const priceB = getPricingDisplay(toolB);
const linkA = getAffiliateLink(toolA, `compare-${toolA.slug}-vs-${toolB.slug}`, "recommendation");
const linkB = getAffiliateLink(toolB, `compare-${toolA.slug}-vs-${toolB.slug}`, "recommendation");

// --- Data-driven helpers for per-pair content ---

function featureOverlap(a: Tool, b: Tool): string[] {
  return a.key_features.filter((f) => b.key_features.includes(f));
}

function uniqueFeatures(tool: Tool, other: Tool): string[] {
  return tool.key_features.filter((f) => !other.key_features.includes(f));
}

const sharedFeatures = featureOverlap(toolA, toolB);
const uniqueA = uniqueFeatures(toolA, toolB);
const uniqueB = uniqueFeatures(toolB, toolA);

// Determine the winner based on data signals
function pickWinner(a: Tool, b: Tool): "a" | "b" | "tie" {
  let scoreA = 0;
  let scoreB = 0;
  // Rating advantage
  const avgA = getAverageRating(a);
  const avgB = getAverageRating(b);
  if (avgA !== null && avgB !== null) {
    if (avgA > avgB) scoreA += 2;
    else if (avgB > avgA) scoreB += 2;
  }
  // Feature count
  if (a.key_features.length > b.key_features.length) scoreA += 1;
  else if (b.key_features.length > a.key_features.length) scoreB += 1;
  // Pricing (lower is better for value)
  if (a.starting_price_monthly !== null && b.starting_price_monthly !== null) {
    if (a.starting_price_monthly < b.starting_price_monthly) scoreA += 1;
    else if (b.starting_price_monthly < a.starting_price_monthly) scoreB += 1;
  }
  if (scoreA > scoreB) return "a";
  if (scoreB > scoreA) return "b";
  return "tie";
}

const winner = pickWinner(toolA, toolB);

// Per-pair quick verdicts derived from data
type PairKey = string;
const quickVerdicts: Record<PairKey, string> = {
  "digitail-vs-ezyvet": `${toolA.name} is the better fit for practices that want AI-powered note generation and a modern mobile experience at a lower price point. ${toolB.name} is the stronger choice for large, multi-location hospitals that need maximum customization and deep IDEXX integration.`,
  "digitail-vs-shepherd": `${toolB.name} wins on affordability and simplicity for solo vets and startup practices, while ${toolA.name} offers a broader feature set with AI-driven clinical tools for growing, multi-location clinics.`,
  "ezyvet-vs-vetspire": `Both are premium platforms, but ${toolA.name} edges ahead for large multi-location enterprises thanks to its customizable workflows. ${toolB.name} is the better pick for specialty and teaching hospitals that need clinical decision support.`,
  "daysmart-vet-vs-hippo-manager": `These two compete head-to-head on price and simplicity. ${toolA.name} has stronger client communication tools (two-way texting, automated waitlists), while ${toolB.name} offers a cleaner, more streamlined interface for the most budget-conscious practices.`,
  "shepherd-vs-vetbadger": `Both are affordable cloud platforms aimed at small practices. ${toolA.name} stands out with its vet-built workflow design and startup discounts, while ${toolB.name} differentiates with its focus on work-life balance and burnout reduction.`,
};

const pairKey = `${toolA.slug}-vs-${toolB.slug}`;
const quickVerdict = quickVerdicts[pairKey] || `Both ${toolA.name} and ${toolB.name} are solid veterinary software options. Your choice depends on practice size, budget, and which feature priorities matter most to your team.`;

// Per-pair feature-by-feature analysis
