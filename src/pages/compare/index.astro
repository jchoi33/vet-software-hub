---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getAllActiveTools, getAllActiveComparisonPairs, getComparisonSlug, getAverageRating, getPricingDisplay } from "../../utils/tools";
import type { Tool } from "../../utils/tools";

const allTools = getAllActiveTools();
const allPairs = getAllActiveComparisonPairs();
const pairCount = allPairs.length;

// Popular comparisons — 12 hand-curated pairs
const popularComparisons = [
  { slugA: "digitail", slugB: "ezyvet" },
  { slugA: "digitail", slugB: "shepherd" },
  { slugA: "ezyvet", slugB: "vetspire" },
  { slugA: "shepherd", slugB: "hippo-manager" },
  { slugA: "daysmart-vet", slugB: "hippo-manager" },
  { slugA: "ezyvet", slugB: "cornerstone" },
  { slugA: "shepherd", slugB: "vetbadger" },
  { slugA: "digitail", slugB: "daysmart-vet" },
  { slugA: "ezyvet", slugB: "provet-cloud" },
  { slugA: "digitail", slugB: "vetspire" },
  { slugA: "shepherd", slugB: "daysmart-vet" },
  { slugA: "hippo-manager", slugB: "vetbadger" },
];

// Build popular pair cards with display data
const toolMap = new Map(allTools.map((t) => [t.slug, t]));

const popularCards = popularComparisons
  .map(({ slugA, slugB }) => {
    const a = toolMap.get(slugA);
    const b = toolMap.get(slugB);
    if (!a || !b) return null;
    const slug = getComparisonSlug(a, b);
    const priceA = a.starting_price_monthly ? "$" + a.starting_price_monthly + "/mo" : "Custom";
    const priceB = b.starting_price_monthly ? "$" + b.starting_price_monthly + "/mo" : "Custom";
    return { a, b, slug, priceA, priceB, label: a.name + " vs " + b.name };
  })
  .filter(Boolean) as { a: Tool; b: Tool; slug: string; priceA: string; priceB: string; label: string }[];

// Group ALL pairs by alphabetically-first tool name
type PairEntry = { slug: string; otherName: string; otherSlug: string };
const groupedPairs: Record<string, PairEntry[]> = {};

for (const [toolA, toolB] of allPairs) {
  const slug = getComparisonSlug(toolA, toolB);
  const sorted = [toolA, toolB].sort((a, b) => a.slug.localeCompare(b.slug));
  const groupName = sorted[0].name;
  const otherName = sorted[1].name;
  const otherSlug = sorted[1].slug;
  if (!groupedPairs[groupName]) groupedPairs[groupName] = [];
  groupedPairs[groupName].push({ slug, otherName, otherSlug });
}

const sortedGroups = Object.entries(groupedPairs).sort(([a], [b]) => a.localeCompare(b));

// Serialize tools data for the client-side comparison selector
const toolsForSelector = allTools.map((t) => ({
  name: t.name,
  slug: t.slug,
  tagline: t.tagline,
  price: t.starting_price_monthly ? "$" + t.starting_price_monthly + "/mo" : (t.free_plan ? "Free plan" : "Custom"),
  rawPrice: t.starting_price_monthly,
  initial: t.name.charAt(0).toUpperCase(),
  rating_g2: t.rating_g2,
  rating_capterra: t.rating_capterra,
  free_trial: t.free_trial,
  free_plan: t.free_plan,
  deployment: t.deployment,
  features: t.key_features,
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Veterinary Software Comparisons",
  description: pairCount + " side-by-side veterinary practice management software comparisons.",
  url: "https://vetsoftwares.com/compare",
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://vetsoftwares.com" },
      { "@type": "ListItem", position: 2, name: "Compare", item: "https://vetsoftwares.com/compare" },
    ],
  },
};
---

<BaseLayout
  title={"Veterinary Software Comparisons 2026 — " + pairCount + " Side-by-Side Reviews | VetSoftwares"}
  description={"Browse " + pairCount + " veterinary practice management software comparisons. Side-by-side pricing, features, and honest recommendations for every major PIMS pairing."}
  canonical="https://vetsoftwares.com/compare"
  schema={schema}
>

  <!-- ═══ PAGE BANNER ═══ -->
  <section style="background:#1a2416; border-bottom:1px solid #2d3d26; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:2rem; padding-bottom:2rem;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap;">

        <!-- Left: breadcrumb + title + subtitle -->
        <div style="flex:1; min-width:0;">
          <nav style="margin-bottom:0.625rem;">
            <ol style="display:inline-flex; align-items:center; gap:0.4rem; list-style:none; padding:0; margin:0; font-family:var(--font-body); font-size:0.75rem; color:#5a7a4a;">
              <li><a href="/" style="color:#5a7a4a; text-decoration:none; transition:color 0.15s;" onmouseover="this.style.color='#9aba82';" onmouseout="this.style.color='#5a7a4a';">Home</a></li>
              <li style="color:#3a4f34;">/</li>
              <li style="color:#c4d5b7; font-weight:600;">Compare</li>
            </ol>
          </nav>
          <h1 style="font-family:var(--font-heading); font-size:clamp(1.375rem,3vw,1.875rem); font-weight:800; color:white; line-height:1.2; margin:0 0 0.5rem;">
            Veterinary Software Comparisons
          </h1>
          <p style="font-family:var(--font-body); font-size:0.9375rem; color:#8aab72; line-height:1.6; margin:0; max-width:520px;">
            Every major PIMS paired against every other, with honest feature, pricing, and fit analysis. Zero vendor bias.
          </p>
        </div>

        <!-- Right: stats -->
        <div style="display:flex; gap:0.75rem; flex-shrink:0; flex-wrap:wrap;">
          {[
            { stat: String(pairCount), label: "Comparisons" },
            { stat: String(allTools.length), label: "Tools Covered" },
            { stat: "2026", label: "Data Current" },
          ].map((item) => (
            <div style="background:rgba(255,255,255,0.05); border:1px solid #2d3d26; border-radius:10px; padding:0.625rem 1rem; text-align:center; min-width:90px;">
              <div style="font-family:var(--font-mono); font-size:1.25rem; font-weight:700; color:#fbbf24; line-height:1;">{item.stat}</div>
              <div style="font-family:var(--font-body); font-size:0.68rem; color:#5a7a4a; margin-top:0.2rem; font-weight:500; text-transform:uppercase; letter-spacing:0.04em;">{item.label}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ COMPARISON SELECTOR TOOL ═══ -->
  <section class="container-wide" style="padding-top:4rem; padding-bottom:0;">

    <SectionHeader
      label="Build Your Comparison"
      title="Pick up to 3 tools to compare"
      subtitle="Search for any veterinary software and compare them side-by-side instantly."
      align="center"
    />

    <!-- Selector widget -->
    <div id="compare-tool" style="margin-top:2rem; background:white; border:1px solid #dde5d5; border-radius:16px; padding:2rem 2rem 1.5rem; max-width:800px; margin-left:auto; margin-right:auto; margin-top:2rem;">

      <!-- Selected tools display -->
      <div id="selected-tools" style="display:flex; gap:0.75rem; flex-wrap:wrap; margin-bottom:1.25rem; min-height:52px; align-items:center;">
        <span id="empty-hint" style="font-family:var(--font-body); font-size:0.875rem; color:#a8a29e; font-style:italic;">No tools selected yet — search below to add up to 3</span>
      </div>

      <!-- Search input -->
      <div style="position:relative;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#a8a29e" style="position:absolute; left:0.875rem; top:50%; transform:translateY(-50%); width:18px;height:18px; pointer-events:none;">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
        </svg>
        <input
          id="tool-search"
          type="text"
          placeholder="Search for a tool, e.g. &quot;ezyVet&quot; or &quot;Shepherd&quot;…"
          autocomplete="off"
          style="width:100%; box-sizing:border-box; font-family:var(--font-body); font-size:0.9375rem; color:#292524; background:#fdf9f3; border:1.5px solid #dde5d5; border-radius:10px; padding:0.75rem 0.875rem 0.75rem 2.75rem; outline:none; transition:border-color 0.2s, box-shadow 0.2s;"
        />
        <!-- Dropdown -->
        <div
          id="search-dropdown"
          style="display:none; position:absolute; top:calc(100% + 6px); left:0; right:0; background:white; border:1.5px solid #dde5d5; border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,0.10); z-index:100; max-height:280px; overflow-y:auto;"
        ></div>
      </div>

      <!-- Compare button -->
      <div style="display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem; padding-top:1.25rem; border-top:1px solid #f0ece4;">
        <span id="selection-count" style="font-family:var(--font-body); font-size:0.8rem; color:#a8a29e;">0 of 3 selected</span>
        <button
          id="compare-btn"
          disabled
          style="display:inline-flex; align-items:center; gap:0.5rem; background:#466c34; color:white; font-family:var(--font-body); font-size:0.9rem; font-weight:600; padding:0.625rem 1.375rem; border-radius:8px; border:none; cursor:not-allowed; opacity:0.45; transition:opacity 0.2s, background 0.2s;"
        >
          Compare Selected
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px;">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l3.158-2.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Live preview panel — shown once 2+ tools selected -->
    <div id="compare-preview" style="display:none; max-width:800px; margin:1.5rem auto 0; background:white; border:1px solid #dde5d5; border-radius:16px; overflow:hidden;">

      <!-- Preview header -->
      <div style="background:#1a2416; padding:0.875rem 1.25rem; display:flex; align-items:center; gap:0.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#fbbf24" style="width:15px;height:15px;flex-shrink:0;">
          <path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" />
          <path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
        </svg>
        <span style="font-family:var(--font-body); font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#c4d5b7;">Live Preview</span>
      </div>

      <!-- Preview table rendered by JS -->
      <div id="preview-table-container" style="overflow-x:auto;">
        <!-- filled by renderPreview() -->
      </div>

    </div>

    <!-- Note about 3-tool limit -->
    <p style="text-align:center; font-family:var(--font-body); font-size:0.8rem; color:#a8a29e; margin-top:0.875rem; margin-bottom:0;">
      Comparing 3 tools? We'll route you to the first pair. <a href="#full-index" style="color:#466c34; text-decoration:none; font-weight:600;">Browse all {pairCount} comparisons below.</a>
    </p>

  </section>

  <!-- ═══ POPULAR COMPARISONS ═══ -->
  <section class="container-wide" style="padding-top:4rem; padding-bottom:4rem;">

    <SectionHeader
      label="Most Viewed"
      title="Popular Comparisons"
      subtitle="The matchups vet practice managers search for most — broken down feature by feature."
      align="center"
    />

    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:1rem; margin-top:2.5rem;">
      {popularCards.map(({ a, b, slug, priceA, priceB, label }) => (
        <a
          href={"/compare/" + slug}
          style="display:block; background:white; border:1px solid #dde5d5; border-radius:12px; padding:1.25rem 1.375rem; text-decoration:none; transition:box-shadow 0.2s, border-color 0.2s, transform 0.2s;"
          onmouseover="this.style.boxShadow='0 8px 24px rgba(0,0,0,0.08)';this.style.borderColor='#c4d5b7';this.style.transform='translateY(-2px)';"
          onmouseout="this.style.boxShadow='none';this.style.borderColor='#dde5d5';this.style.transform='none';"
        >
          <!-- Tool A -->
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.5rem;">
            <span style="font-family:var(--font-heading); font-size:0.9375rem; font-weight:700; color:#1a2416;">{a.name}</span>
            <span style="font-family:var(--font-mono); font-size:0.775rem; color:#78716c;">{priceA}</span>
          </div>
          <!-- VS divider -->
          <div style="font-family:var(--font-body); font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#b0a99a; margin-bottom:0.5rem;">vs</div>
          <!-- Tool B -->
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
            <span style="font-family:var(--font-heading); font-size:0.9375rem; font-weight:700; color:#1a2416;">{b.name}</span>
            <span style="font-family:var(--font-mono); font-size:0.775rem; color:#78716c;">{priceB}</span>
          </div>
          <div style="font-family:var(--font-body); font-size:0.8rem; font-weight:600; color:#466c34;">Compare →</div>
        </a>
      ))}
    </div>

  </section>

  <!-- ═══ BROWSE ALL ═══ -->
  <section id="full-index" style="background:#f2f5ef; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:4rem; padding-bottom:4.5rem;">

      <SectionHeader
        label="Full Index"
        title={"All " + pairCount + " Comparisons"}
        subtitle="Browse every pairing, grouped by tool."
        align="center"
      />

      <div style="margin-top:2.5rem; display:flex; flex-direction:column; gap:2rem;">
        {sortedGroups.map(([groupName, pairs]) => (
          <div>
            <h3 style="font-family:var(--font-heading); font-size:1rem; font-weight:700; color:#1a2416; margin:0 0 0.75rem; padding-bottom:0.5rem; border-bottom:1px solid #dde5d5;">
              {groupName} vs…
            </h3>
            <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">
              {pairs.map(({ slug, otherName }) => (
                <a
                  href={"/compare/" + slug}
                  style="font-family:var(--font-body); font-size:0.8rem; font-weight:600; color:#344a2b; background:#f2f5ef; border:1px solid #c4d5b7; border-radius:999px; padding:0.3rem 0.85rem; text-decoration:none; transition:background 0.15s;"
                  onmouseover="this.style.background='#e2eadb';"
                  onmouseout="this.style.background='#f2f5ef';"
                >
                  {otherName}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section style="margin:0 -1.5rem; padding:0 1.5rem;">
    <EmailCapture variant="dark" />
  </section>

</BaseLayout>

<script define:vars={{ toolsForSelector }}>
  // ── Comparison Selector Tool ───────────────────────────────────────────
  const tools = toolsForSelector;
  const MAX_SELECTED = 3;
  let selected = []; // array of { name, slug, price, initial }

  const searchInput = document.getElementById('tool-search');
  const dropdown = document.getElementById('search-dropdown');
  const selectedContainer = document.getElementById('selected-tools');
  const emptyHint = document.getElementById('empty-hint');
  const countLabel = document.getElementById('selection-count');
  const compareBtn = document.getElementById('compare-btn');
  const comparePreview = document.getElementById('compare-preview');
  const previewTableContainer = document.getElementById('preview-table-container');

  // ── Live preview table ────────────────────────────────────────────────
  function starStr(rating) {
    if (rating === null) return '<span style="color:#a8a29e;">N/A</span>';
    const full = Math.floor(rating);
    const half = rating - full >= 0.5;
    let s = '';
    for (let i = 0; i < full; i++) s += '★';
    if (half) s += '½';
    return '<span style="color:#f59e0b;">' + s + '</span> <span style="color:#57534e;font-size:0.72rem;">' + rating.toFixed(1) + '</span>';
  }

  function yesNo(val) {
    return val
      ? '<span style="color:#466c34;font-weight:600;">Yes</span>'
      : '<span style="color:#a8a29e;">No</span>';
  }

  function renderPreview() {
    if (selected.length < 2) {
      comparePreview.style.display = 'none';
      return;
    }
    comparePreview.style.display = 'block';

    const colCount = selected.length;
    // Build full tool data for each selected slug
    const fullTools = selected.map(s => tools.find(t => t.slug === s.slug));

    const rows = [
      { label: 'Starting Price', key: 'price' },
      { label: 'G2 Rating',      key: 'rating_g2' },
      { label: 'Capterra Rating',key: 'rating_capterra' },
      { label: 'Free Trial',     key: 'free_trial' },
      { label: 'Free Plan',      key: 'free_plan' },
      { label: 'Deployment',     key: 'deployment' },
    ];

    let colW = Math.floor(80 / colCount);
    let html = '<table style="width:100%;border-collapse:collapse;font-family:var(--font-body);font-size:0.8125rem;">';

    // Header row
    html += '<thead><tr>';
    html += '<th style="width:20%;padding:0.625rem 1rem;text-align:left;background:#f9faf8;border-bottom:1px solid #dde5d5;color:#78716c;font-weight:600;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.05em;">Feature</th>';
    fullTools.forEach((t, i) => {
      html += '<th style="width:' + colW + '%;padding:0.625rem 1rem;text-align:left;background:#f9faf8;border-bottom:1px solid #dde5d5;color:#1a2416;font-weight:700;">';
      html += '<div style="display:flex;align-items:center;gap:0.5rem;">';
      html += '<div style="width:24px;height:24px;background:#466c34;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><span style="color:white;font-weight:700;font-size:0.75rem;">' + t.initial + '</span></div>';
      html += t.name;
      html += '</div></th>';
    });
    html += '</tr></thead>';

    // Body rows
    html += '<tbody>';
    rows.forEach((row, ri) => {
      const bg = ri % 2 === 0 ? 'background:white;' : 'background:#f9faf8;';
      html += '<tr style="' + bg + '">';
      html += '<td style="padding:0.5rem 1rem;color:#78716c;font-weight:500;border-bottom:1px solid #f2f5ef;">' + row.label + '</td>';

      // Compute values for each tool
      const vals = fullTools.map(t => {
        if (row.key === 'price') return t.price;
        if (row.key === 'rating_g2') return { raw: t.rating_g2, html: starStr(t.rating_g2) };
        if (row.key === 'rating_capterra') return { raw: t.rating_capterra, html: starStr(t.rating_capterra) };
        if (row.key === 'free_trial') return { raw: t.free_trial, html: yesNo(t.free_trial) };
        if (row.key === 'free_plan') return { raw: t.free_plan, html: yesNo(t.free_plan) };
        if (row.key === 'deployment') return t.deployment;
        return '-';
      });

      // Determine winner for numeric/boolean fields
      let winnerIdx = -1;
      if (row.key === 'price') {
        // lower price wins
        const prices = fullTools.map(t => t.rawPrice);
        const valid = prices.filter(p => p !== null);
        if (valid.length > 0) {
          const minP = Math.min(...valid);
          const winCount = prices.filter(p => p === minP).length;
          if (winCount === 1) winnerIdx = prices.indexOf(minP);
        }
      } else if (row.key === 'rating_g2' || row.key === 'rating_capterra') {
        const ratings = fullTools.map(t => row.key === 'rating_g2' ? t.rating_g2 : t.rating_capterra);
        const valid = ratings.filter(r => r !== null);
        if (valid.length > 0) {
          const maxR = Math.max(...valid);
          const winCount = ratings.filter(r => r === maxR).length;
          if (winCount === 1) winnerIdx = ratings.indexOf(maxR);
        }
      } else if (row.key === 'free_trial' || row.key === 'free_plan') {
        const bools = fullTools.map(t => row.key === 'free_trial' ? t.free_trial : t.free_plan);
        const trueCount = bools.filter(Boolean).length;
        if (trueCount === 1) winnerIdx = bools.indexOf(true);
      }

      vals.forEach((val, vi) => {
        const isWinner = vi === winnerIdx;
        const cellBg = isWinner ? 'background:#f2f5ef;' : '';
        const content = typeof val === 'object' && val.html ? val.html : String(val);
        html += '<td style="padding:0.5rem 1rem;border-bottom:1px solid #f2f5ef;' + cellBg + 'color:#292524;">' + content + '</td>';
      });

      html += '</tr>';
    });

    // Key features overlap row
    const bg = rows.length % 2 === 0 ? 'background:white;' : 'background:#f9faf8;';
    html += '<tr style="' + bg + '">';
    html += '<td style="padding:0.5rem 1rem;color:#78716c;font-weight:500;vertical-align:top;">Key Features</td>';
    fullTools.forEach(t => {
      html += '<td style="padding:0.5rem 1rem;vertical-align:top;color:#292524;">';
      html += '<ul style="list-style:disc;padding-left:1.1rem;margin:0;display:flex;flex-direction:column;gap:0.2rem;">';
      t.features.slice(0, 5).forEach(f => { html += '<li style="font-size:0.775rem;">' + f + '</li>'; });
      if (t.features.length > 5) html += '<li style="font-size:0.72rem;color:#a8a29e;">+' + (t.features.length - 5) + ' more</li>';
      html += '</ul></td>';
    });
    html += '</tr>';

    html += '</tbody></table>';

    // Compare link row if exactly 2 tools
    if (selected.length === 2) {
      const slugs = selected.map(s => s.slug).sort();
      const url = '/compare/' + slugs[0] + '-vs-' + slugs[1];
      html += '<div style="padding:0.875rem 1rem;background:#f9faf8;border-top:1px solid #dde5d5;text-align:right;">';
      html += '<a href="' + url + '" style="font-family:var(--font-body);font-size:0.8rem;font-weight:600;color:#466c34;text-decoration:none;">View full ' + selected[0].name + ' vs ' + selected[1].name + ' comparison →</a>';
      html += '</div>';
    }

    previewTableContainer.innerHTML = html;
  }

  // Render selected tool chips
  function renderSelected() {
    // Remove all chips (keep empty-hint span)
    const chips = selectedContainer.querySelectorAll('.tool-chip');
    chips.forEach(c => c.remove());

    if (selected.length === 0) {
      emptyHint.style.display = '';
    } else {
      emptyHint.style.display = 'none';
      selected.forEach((tool, idx) => {
        const chip = document.createElement('div');
        chip.className = 'tool-chip';
        chip.style.cssText = 'display:inline-flex;align-items:center;gap:0.5rem;background:#f2f5ef;border:1.5px solid #c4d5b7;border-radius:8px;padding:0.375rem 0.625rem 0.375rem 0.5rem;';
        chip.innerHTML =
          '<div style="width:28px;height:28px;background:#466c34;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
            '<span style="font-family:var(--font-heading);font-size:0.8rem;font-weight:700;color:white;">' + tool.initial + '</span>' +
          '</div>' +
          '<span style="font-family:var(--font-body);font-size:0.8375rem;font-weight:600;color:#1a2416;">' + tool.name + '</span>' +
          '<span style="font-family:var(--font-mono);font-size:0.72rem;color:#78716c;">' + tool.price + '</span>' +
          '<button data-idx="' + idx + '" style="background:none;border:none;cursor:pointer;padding:0 2px;color:#a8a29e;font-size:1rem;line-height:1;display:flex;align-items:center;" aria-label="Remove ' + tool.name + '">×</button>';
        selectedContainer.appendChild(chip);
      });

      // Remove button handlers
      selectedContainer.querySelectorAll('button[data-idx]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const i = parseInt(btn.getAttribute('data-idx'));
          selected.splice(i, 1);
          renderSelected();
          updateCompareBtn();
          renderPreview();
        });
      });
    }

    countLabel.textContent = selected.length + ' of ' + MAX_SELECTED + ' selected';
  }

  // Enable/disable compare button
  function updateCompareBtn() {
    if (selected.length >= 2) {
      compareBtn.disabled = false;
      compareBtn.style.opacity = '1';
      compareBtn.style.cursor = 'pointer';
    } else {
      compareBtn.disabled = true;
      compareBtn.style.opacity = '0.45';
      compareBtn.style.cursor = 'not-allowed';
    }
  }

  // Filter tools by query
  function getMatches(query) {
    if (!query.trim()) return [];
    const q = query.toLowerCase();
    return tools
      .filter(t => {
        // Exclude already selected
        if (selected.some(s => s.slug === t.slug)) return false;
        return t.name.toLowerCase().includes(q) || t.tagline.toLowerCase().includes(q);
      })
      .slice(0, 8);
  }

  // Render dropdown
  function renderDropdown(query) {
    const matches = getMatches(query);
    if (matches.length === 0 || selected.length >= MAX_SELECTED) {
      dropdown.style.display = 'none';
      return;
    }
    dropdown.style.display = 'block';
    dropdown.innerHTML = matches.map((t, i) =>
      '<button class="dd-item" data-slug="' + t.slug + '" style="display:flex;align-items:center;gap:0.75rem;width:100%;background:none;border:none;cursor:pointer;padding:0.625rem 0.875rem;text-align:left;border-bottom:1px solid #f5f5f4;transition:background 0.12s;">' +
        '<div style="width:32px;height:32px;background:#f2f5ef;border:1px solid #c4d5b7;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
          '<span style="font-family:var(--font-heading);font-size:0.875rem;font-weight:700;color:#344a2b;">' + t.initial + '</span>' +
        '</div>' +
        '<div style="flex:1;min-width:0;">' +
          '<div style="font-family:var(--font-body);font-size:0.875rem;font-weight:600;color:#1a2416;">' + t.name + '</div>' +
          '<div style="font-family:var(--font-body);font-size:0.75rem;color:#78716c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + t.tagline + '</div>' +
        '</div>' +
        '<span style="font-family:var(--font-mono);font-size:0.75rem;color:#78716c;flex-shrink:0;">' + t.price + '</span>' +
      '</button>'
    ).join('');

    // Hover styles + click handlers
    dropdown.querySelectorAll('.dd-item').forEach(item => {
      item.addEventListener('mouseenter', () => { item.style.background = '#f2f5ef'; });
      item.addEventListener('mouseleave', () => { item.style.background = 'none'; });
      item.addEventListener('click', () => {
        const slug = item.getAttribute('data-slug');
        const tool = tools.find(t => t.slug === slug);
        if (tool && selected.length < MAX_SELECTED) {
          selected.push(tool);
          renderSelected();
          updateCompareBtn();
          renderPreview();
        }
        searchInput.value = '';
        dropdown.style.display = 'none';
        searchInput.focus();
      });
    });
  }

  // Search input events
  searchInput.addEventListener('input', (e) => {
    renderDropdown(e.target.value);
  });

  searchInput.addEventListener('focus', (e) => {
    if (e.target.value) renderDropdown(e.target.value);
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdown.style.display = 'none';
      searchInput.blur();
    }
  });

  // Focus styles
  searchInput.addEventListener('focus', () => {
    searchInput.style.borderColor = '#466c34';
    searchInput.style.boxShadow = '0 0 0 3px rgba(70,108,52,0.12)';
  });
  searchInput.addEventListener('blur', () => {
    searchInput.style.borderColor = '#dde5d5';
    searchInput.style.boxShadow = 'none';
    // Delay hiding dropdown to allow click
    setTimeout(() => { dropdown.style.display = 'none'; }, 150);
  });

  // Compare button — navigate to comparison URL
  compareBtn.addEventListener('click', () => {
    if (selected.length < 2) return;
    // Sort slugs alphabetically (same as getComparisonSlug)
    const slugs = selected.map(t => t.slug).sort();
    // For 2 tools: /compare/a-vs-b
    // For 3 tools: route to first pair (a vs b), then user can go back for others
    const url = '/compare/' + slugs[0] + '-vs-' + slugs[1];
    window.location.href = url;
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!document.getElementById('compare-tool').contains(e.target)) {
      dropdown.style.display = 'none';
    }
  });
</script>
