---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import EmailCapture from "../components/EmailCapture.astro";
import { getAllTools, getAverageRating } from "../utils/tools";

const allTools = getAllTools();

// Top 5 picks: highest average rating among tools with affiliate programs + good data
const top5 = allTools
  .filter((t) => t.affiliate_program && t.rating_g2 !== null)
  .sort((a, b) => {
    const ra = getAverageRating(a) ?? 0;
    const rb = getAverageRating(b) ?? 0;
    return rb - ra;
  })
  .slice(0, 5);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "VetSoftwareHub",
  url: "https://vetsoftwarehub.com",
  description:
    "Independent reviews and comparisons of veterinary practice management software. Helping 33,000+ vet practices find the right PIMS.",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://vetsoftwarehub.com/compare/{search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title="Best Veterinary Practice Management Software 2026 — Independent Reviews | VetSoftwareHub"
  description="Compare 20+ veterinary practice management software options. Independent reviews, pricing comparisons, and honest recommendations for vet clinics of every size."
  canonical="https://vetsoftwarehub.com"
  schema={schema}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-navy-900 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-accent-500/20 to-navy-950"></div>
    </div>
    <div class="relative mx-auto max-w-5xl py-20 sm:py-28 text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent-400">
        Independent & Unbiased Reviews
      </p>
      <h1 class="font-heading text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl">
        Find the Right Software<br />
        for Your Veterinary Practice
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-navy-200">
        We independently review and compare 20+ veterinary practice management systems
        so you don't have to. Real data. Honest opinions. No vendor bias.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="#top-picks"
          class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-8 py-3.5 text-base font-semibold text-white transition-all hover:bg-accent-400 hover:shadow-lg hover:shadow-accent-500/25"
        >
          See Our Top Picks
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          href="/compare/digitail-vs-ezyvet"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-white/30 px-8 py-3.5 text-base font-semibold text-white transition-all hover:border-white/60 hover:bg-white/10"
        >
          Compare Two Tools
        </a>
      </div>
      <div class="mt-12 flex items-center justify-center gap-8 text-sm text-navy-300">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-accent-400">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
          20+ Tools Reviewed
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-accent-400">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
          100% Independent
        </div>
        <div class="hidden items-center gap-2 sm:flex">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-accent-400">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
          Updated February 2026
        </div>
      </div>
    </div>
  </section>

  <!-- Top 5 Picks Section -->
  <section id="top-picks" class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="text-center">
      <h2 class="font-heading text-3xl font-bold text-navy-900 sm:text-4xl">
        Top 5 Veterinary Software Picks for 2026
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-navy-500">
        Based on features, pricing, user reviews, and hands-on evaluation.
        We rank tools by real merit, not commission rates.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {top5.map((tool, index) => (
        <div class={index === 0 ? "sm:col-span-2 lg:col-span-1" : ""}>
          <div class="relative">
            <span class="absolute -left-2 -top-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-navy-900 text-sm font-bold text-white shadow-md">
              #{index + 1}
            </span>
            <ToolCard tool={tool} />
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-3 text-center sm:flex sm:flex-wrap sm:justify-center sm:gap-6">
      {allTools.slice(0, 8).map((tool) => (
        <a
          href={`/reviews/${tool.slug}`}
          class="text-sm font-semibold text-accent-600 hover:text-accent-500 transition-colors"
        >
          {tool.name} →
        </a>
      ))}
      <span class="hidden text-navy-300 sm:inline">|</span>
      <a
        href={`/reviews/${allTools[0].slug}`}
        class="text-sm font-semibold text-navy-500 hover:text-accent-500 transition-colors"
      >
        See all {allTools.length} reviews →
      </a>
    </div>
  </section>

  <!-- How We're Different Section -->
  <section class="bg-navy-50 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl py-16 sm:py-20">
      <div class="text-center">
        <h2 class="font-heading text-3xl font-bold text-navy-900 sm:text-4xl">
          Why Trust VetSoftwareHub?
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-navy-500">
          Every other "best vet software" list is written by a vendor ranking themselves #1.
          We're the only independent comparison site in the veterinary PIMS space.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        <div class="rounded-xl bg-white p-6 shadow-sm border border-navy-100">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-accent-100 text-accent-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
              <path d="M11.644 1.59a.75.75 0 01.712 0l9.75 5.25a.75.75 0 010 1.32l-9.75 5.25a.75.75 0 01-.712 0l-9.75-5.25a.75.75 0 010-1.32l9.75-5.25z" />
              <path d="M3.265 10.602l7.668 4.129a2.25 2.25 0 002.134 0l7.668-4.13 1.37.739a.75.75 0 010 1.32l-9.75 5.25a.75.75 0 01-.71 0l-9.75-5.25a.75.75 0 010-1.32l1.37-.738z" />
            </svg>
          </div>
          <h3 class="font-heading mt-4 text-lg font-bold text-navy-900">No Vendor Bias</h3>
          <p class="mt-2 text-sm text-navy-500">
            We don't sell software. Our revenue comes from affiliate commissions,
            which we fully disclose. Rankings are based on merit alone.
          </p>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-sm border border-navy-100">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-accent-100 text-accent-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
              <path fill-rule="evenodd" d="M2.25 13.5a8.25 8.25 0 018.25-8.25.75.75 0 01.75.75v6.75H18a.75.75 0 01.75.75 8.25 8.25 0 01-16.5 0z" clip-rule="evenodd" />
              <path fill-rule="evenodd" d="M12.75 3a.75.75 0 01.75-.75 8.25 8.25 0 018.25 8.25.75.75 0 01-.75.75h-8.25V3z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="font-heading mt-4 text-lg font-bold text-navy-900">Real Data</h3>
          <p class="mt-2 text-sm text-navy-500">
            Pricing, ratings, and features come from verified public sources.
            We aggregate reviews from G2 and Capterra for balanced perspectives.
          </p>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-sm border border-navy-100">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-accent-100 text-accent-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
              <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0112 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 013.498 1.307 4.491 4.491 0 011.307 3.497A4.49 4.49 0 0121.75 12a4.49 4.49 0 01-1.549 3.397 4.491 4.491 0 01-1.307 3.497 4.491 4.491 0 01-3.497 1.307A4.49 4.49 0 0112 21.75a4.49 4.49 0 01-3.397-1.549 4.49 4.49 0 01-3.498-1.306 4.491 4.491 0 01-1.307-3.498A4.49 4.49 0 012.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 011.307-3.497 4.49 4.49 0 013.497-1.307zm7.007 6.387a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="font-heading mt-4 text-lg font-bold text-navy-900">Built for Vets</h3>
          <p class="mt-2 text-sm text-navy-500">
            Written for practice managers and hospital administrators,
            not IT departments. We explain everything in plain language.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Wizard CTA Section -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="overflow-hidden rounded-2xl bg-gradient-to-r from-navy-900 to-navy-800 shadow-xl">
      <div class="grid items-center gap-8 p-8 sm:p-12 lg:grid-cols-2">
        <div>
          <h2 class="font-heading text-3xl font-bold text-white sm:text-4xl">
            Not Sure Which Software Is Right?
          </h2>
          <p class="mt-4 text-lg text-navy-200">
            Use our side-by-side comparison tool to evaluate any two veterinary practice
            management systems across pricing, features, ratings, and more.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="/compare/digitail-vs-ezyvet"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-500 px-6 py-3 font-semibold text-white transition-all hover:bg-accent-400"
            >
              Compare Tools Now
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l3.158-2.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-3">
              <div class="rounded-lg bg-white/10 p-4 backdrop-blur-sm">
                <div class="text-sm font-semibold text-white">Digitail</div>
                <div class="mt-1 text-xs text-navy-300">$150/mo &middot; 4.8 rating</div>
              </div>
              <div class="rounded-lg bg-white/10 p-4 backdrop-blur-sm">
                <div class="text-sm font-semibold text-white">Shepherd</div>
                <div class="mt-1 text-xs text-navy-300">$99/mo &middot; 4.9 rating</div>
              </div>
            </div>
            <div class="mt-6 space-y-3">
              <div class="rounded-lg bg-white/10 p-4 backdrop-blur-sm">
                <div class="text-sm font-semibold text-white">ezyVet</div>
                <div class="mt-1 text-xs text-navy-300">$250/mo &middot; 4.5 rating</div>
              </div>
              <div class="rounded-lg bg-white/10 p-4 backdrop-blur-sm">
                <div class="text-sm font-semibold text-white">Vetspire</div>
                <div class="mt-1 text-xs text-navy-300">$349/mo &middot; 4.6 rating</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Feature Grid -->
  <section class="bg-navy-50 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl py-16 sm:py-20">
      <div class="text-center">
        <h2 class="font-heading text-3xl font-bold text-navy-900 sm:text-4xl">
          Popular Comparisons
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-navy-500">
          The most searched veterinary software matchups, broken down feature by feature.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { a: "Digitail", b: "ezyVet", slug: "digitail-vs-ezyvet" },
          { a: "Digitail", b: "Shepherd", slug: "digitail-vs-shepherd" },
          { a: "ezyVet", b: "Vetspire", slug: "ezyvet-vs-vetspire" },
          { a: "DaySmart Vet", b: "Hippo Manager", slug: "daysmart-vet-vs-hippo-manager" },
          { a: "Shepherd", b: "VetBadger", slug: "shepherd-vs-vetbadger" },
          { a: "ezyVet", b: "Cornerstone", slug: "ezyvet-vs-cornerstone" },
        ].map((comp) => (
          <a
            href={`/compare/${comp.slug}`}
            class="group flex items-center justify-between rounded-xl border border-navy-100 bg-white p-5 shadow-sm transition-all hover:border-accent-300 hover:shadow-md"
          >
            <div>
              <div class="text-sm font-semibold text-navy-900">{comp.a}</div>
              <div class="text-xs text-navy-400">vs</div>
              <div class="text-sm font-semibold text-navy-900">{comp.b}</div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-navy-300 transition-colors group-hover:text-accent-500">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l3.158-2.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Explore All Content -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="text-center">
      <h2 class="font-heading text-3xl font-bold text-navy-900 sm:text-4xl">
        Explore Everything on VetSoftwareHub
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-navy-500">
        228 pages of independent research across every angle you need to make the right PIMS decision.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

      <!-- Reviews -->
      <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-accent-100">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-accent-600">
            <path d="M11.625 16.5a1.875 1.875 0 100-3.75 1.875 1.875 0 000 3.75z" />
            <path fill-rule="evenodd" d="M5.625 1.5H9a3.75 3.75 0 013.75 3.75v1.875c0 1.036.84 1.875 1.875 1.875H16.5a3.75 3.75 0 013.75 3.75v7.875c0 1.035-.84 1.875-1.875 1.875H5.625a1.875 1.875 0 01-1.875-1.875V3.375c0-1.036.84-1.875 1.875-1.875zm6 16.5c.66 0 1.277-.19 1.797-.518l1.048 1.048a.75.75 0 001.06-1.06l-1.047-1.048A3.375 3.375 0 1011.625 18z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="font-heading mt-4 text-lg font-bold text-navy-900">In-Depth Reviews</h3>
        <p class="mt-2 text-sm text-navy-500">Honest, data-driven reviews of every major veterinary PIMS on the market.</p>
        <ul class="mt-4 space-y-1.5">
          {allTools.slice(0, 5).map((tool) => (
            <li>
              <a href={`/reviews/${tool.slug}`} class="text-sm text-accent-600 hover:text-accent-700 transition-colors">
                {tool.name} Review →
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-navy-400">{allTools.length} tools reviewed total</p>
      </div>

      <!-- Comparisons -->
      <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-100">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-blue-600">
            <path d="M18.375 2.25c-1.035 0-1.875.84-1.875 1.875v15.75c0 1.035.84 1.875 1.875 1.875h.75c1.035 0 1.875-.84 1.875-1.875V4.125c0-1.036-.84-1.875-1.875-1.875h-.75zM9.75 8.625c0-1.036.84-1.875 1.875-1.875h.75c1.036 0 1.875.84 1.875 1.875v11.25c0 1.035-.84 1.875-1.875 1.875h-.75a1.875 1.875 0 01-1.875-1.875V8.625zM3 13.125c0-1.036.84-1.875 1.875-1.875h.75c1.036 0 1.875.84 1.875 1.875v6.75c0 1.035-.84 1.875-1.875 1.875h-.75A1.875 1.875 0 013 19.875v-6.75z" />
          </svg>
        </div>
        <h3 class="font-heading mt-4 text-lg font-bold text-navy-900">Head-to-Head Comparisons</h3>
        <p class="mt-2 text-sm text-navy-500">153 side-by-side comparisons across pricing, features, ratings, and fit.</p>
        <ul class="mt-4 space-y-1.5">
          {[
            { label: "Digitail vs ezyVet", slug: "digitail-vs-ezyvet" },
            { label: "Digitail vs Shepherd", slug: "digitail-vs-shepherd" },
            { label: "ezyVet vs Vetspire", slug: "ezyvet-vs-vetspire" },
            { label: "Shepherd vs Hippo Manager", slug: "shepherd-vs-hippo-manager" },
            { label: "DaySmart vs Hippo Manager", slug: "daysmart-vet-vs-hippo-manager" },
          ].map((comp) => (
            <li>
              <a href={`/compare/${comp.slug}`} class="text-sm text-accent-600 hover:text-accent-700 transition-colors">
                {comp.label} →
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-navy-400">153 comparisons total</p>
      </div>

      <!-- Best-for & Alternatives -->
      <div class="rounded-xl border border-navy-100 bg-white p-6 shadow-sm">
        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-emerald-100">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-emerald-600">
            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="font-heading mt-4 text-lg font-bold text-navy-900">Best For & Alternatives</h3>
        <p class="mt-2 text-sm text-navy-500">Find the best software for your specific practice type, or find what to switch to.</p>
        <ul class="mt-4 space-y-1.5">
          <li><a href="/best/best-veterinary-software-for-small-practices" class="text-sm text-accent-600 hover:text-accent-700 transition-colors">Best for Small Practices →</a></li>
          <li><a href="/best/best-veterinary-software-with-ai" class="text-sm text-accent-600 hover:text-accent-700 transition-colors">Best AI Vet Software →</a></li>
          <li><a href="/best/best-cloud-based-veterinary-software" class="text-sm text-accent-600 hover:text-accent-700 transition-colors">Best Cloud-Based →</a></li>
          <li><a href="/alternatives/digitail" class="text-sm text-accent-600 hover:text-accent-700 transition-colors">Digitail Alternatives →</a></li>
          <li><a href="/alternatives/ezyvet" class="text-sm text-accent-600 hover:text-accent-700 transition-colors">ezyVet Alternatives →</a></li>
        </ul>
        <p class="mt-3 text-xs text-navy-400">15 best-for guides · 18 alternatives pages</p>
      </div>

      <!-- Pricing & Guides -->
