---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import EmailCapture from "../components/EmailCapture.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CategoryCard from "../components/CategoryCard.astro";
import { getAllTools, getAverageRating, getAffiliateLink } from "../utils/tools";

const allTools = getAllTools();

// Top 3 picks: highest average rating among tools with affiliate programs
const top3 = allTools
  .filter((t) => t.affiliate_program && t.rating_g2 !== null)
  .sort((a, b) => {
    const ra = getAverageRating(a) ?? 0;
    const rb = getAverageRating(b) ?? 0;
    return rb - ra;
  })
  .slice(0, 3);

// Precompute affiliate links + badge data (avoid template literal issues in Astro HTML)
const badges = ["Editor's Choice", "Runner-Up", "Best Value"];
const badgeColors = ["#0d9488", "#2a5494", "#d97706"];
const rankLabels = ["#1", "#2", "#3"];

const top3WithLinks = top3.map((tool, i) => ({
  tool,
  affiliateLink: getAffiliateLink(tool, "homepage", "top-picks"),
  avgRating: getAverageRating(tool),
  badge: badges[i],
  badgeColor: badgeColors[i],
  rankLabel: rankLabels[i],
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "VetSoftwares",
  url: "https://vetsoftwares.com",
  description:
    "Independent reviews and comparisons of veterinary practice management software. Helping 33,000+ vet practices find the right PIMS.",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://vetsoftwares.com/compare/{search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title="Best Veterinary Practice Management Software 2026 — Independent Reviews | VetSoftwares"
  description="Compare 30+ veterinary practice management software options. Independent reviews, pricing comparisons, and honest recommendations for vet clinics of every size."
  canonical="https://vetsoftwares.com"
  schema={schema}
>

  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════ -->
  <section style="background:linear-gradient(135deg,#0a1628 0%,#162d54 60%,#0f2140 100%); margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:5rem; padding-bottom:5rem; text-align:center;">

      <!-- Badge -->
      <div style="display:inline-flex; align-items:center; gap:0.5rem; background:rgba(45,212,191,0.12); border:1px solid rgba(45,212,191,0.3); border-radius:999px; padding:0.35rem 1rem; margin-bottom:1.75rem;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#2dd4bf" style="width:14px;height:14px;flex-shrink:0;">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
        </svg>
        <span style="font-family:var(--font-body); font-size:0.75rem; font-weight:700; letter-spacing:0.06em; color:#2dd4bf; text-transform:uppercase;">Updated February 2026</span>
      </div>

      <!-- H1 -->
      <h1 style="font-family:var(--font-heading); font-size:clamp(2rem,5vw,3.5rem); font-weight:900; color:white; line-height:1.15; margin:0 auto 1.25rem; max-width:780px;">
        Find the <em style="font-style:italic; color:#2dd4bf;">right</em> software<br>for your vet practice
      </h1>

      <!-- Subtitle -->
      <p style="font-family:var(--font-body); font-size:1.125rem; color:#b9d0ef; line-height:1.7; max-width:600px; margin:0 auto 2.5rem;">
        We independently test and compare 30+ veterinary PIMS
        so you don't have to. Real data. Honest opinions. Zero vendor bias.
      </p>

      <!-- CTAs -->
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem; justify-content:center; margin-bottom:3rem;">
        <a href="#top-picks" class="btn-primary" style="font-size:1rem; padding:0.875rem 2rem;">
          See Our Top Picks
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" style="width:18px;height:18px;">
            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/compare/digitail-vs-ezyvet" style="display:inline-flex; align-items:center; gap:0.5rem; font-family:var(--font-body); font-size:1rem; font-weight:600; color:white; border:1.5px solid rgba(255,255,255,0.35); border-radius:8px; padding:0.875rem 2rem; text-decoration:none; transition:border-color 0.2s, background 0.2s;" onmouseover="this.style.borderColor='rgba(255,255,255,0.7)';this.style.background='rgba(255,255,255,0.07)';" onmouseout="this.style.borderColor='rgba(255,255,255,0.35)';this.style.background='transparent';">
          Compare Side-by-Side
        </a>
      </div>

      <!-- Stat cards -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem; max-width:700px; margin:0 auto;">
        {[
          { stat: "30+", label: "PIMS Reviewed" },
          { stat: "190", label: "Comparisons" },
          { stat: "$0", label: "Vendor Influence" },
          { stat: "2026", label: "Data Current" },
        ].map((item) => (
          <div style="background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.12); border-radius:12px; padding:1.25rem 1rem; text-align:center;">
            <div style="font-family:var(--font-mono); font-size:1.75rem; font-weight:700; color:#2dd4bf; line-height:1;">{item.stat}</div>
            <div style="font-family:var(--font-body); font-size:0.78rem; color:#96b8e7; margin-top:0.35rem; font-weight:500;">{item.label}</div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       METHODOLOGY — HOW WE WORK
  ═══════════════════════════════════════════════════════════ -->
  <section style="background:#f5f5f4; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:4.5rem; padding-bottom:4.5rem;">

      <SectionHeader
        label="Our Methodology"
        title="How we work"
        subtitle="Every review follows a structured, repeatable process — so you can trust the rankings."
        align="center"
      />

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1.5rem; margin-top:2.5rem;">
        {[
          {
            step: "01",
            title: "Data Collection",
            desc: "We pull verified pricing, feature sets, and user ratings from G2, Capterra, and each vendor's own documentation.",
          },
          {
            step: "02",
            title: "Structured Scoring",
            desc: "Each tool is scored across 8 categories: usability, features, pricing, support, integrations, innovation, scalability, and value.",
          },
          {
            step: "03",
            title: "Contextual Testing",
            desc: "We test demos, free trials, and onboarding flows with the eye of a practice manager — not a developer.",
          },
          {
            step: "04",
            title: "Honest Publishing",
            desc: "Rankings are based on merit. We disclose every affiliate relationship. Tools with no affiliate program are ranked equally.",
          },
        ].map((item) => (
          <div style="background:white; border:1px solid #e7e5e4; border-radius:12px; padding:1.75rem; position:relative; overflow:hidden;">
            <div style="font-family:var(--font-mono); font-size:2.5rem; font-weight:700; color:#e7e5e4; line-height:1; margin-bottom:1rem; user-select:none;">{item.step}</div>
            <h3 style="font-family:var(--font-heading); font-size:1.05rem; font-weight:700; color:#0a1628; margin:0 0 0.5rem;">{item.title}</h3>
            <p style="font-family:var(--font-body); font-size:0.875rem; color:#78716c; line-height:1.65; margin:0;">{item.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       TOP PICKS — BEST VETERINARY SOFTWARE 2026
  ═══════════════════════════════════════════════════════════ -->
  <section id="top-picks" class="container-wide" style="padding-top:5rem; padding-bottom:5rem;">

    <SectionHeader
      label="Editor's Top Picks"
      title="Best Veterinary Software of 2026"
      subtitle="Ranked by overall score across features, pricing, support, and real user ratings."
      align="center"
    />

    <div style="margin-top:2.5rem; display:flex; flex-direction:column; gap:1.25rem;">
      {top3WithLinks.map(({ tool, badge, badgeColor, rankLabel }, index) => (
        <div style="position:relative;">
          <!-- Rank + badge row -->
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
            <span style="font-family:var(--font-mono); font-size:0.78rem; font-weight:700; color:#78716c; background:#f5f5f4; border:1px solid #e7e5e4; border-radius:6px; padding:0.2rem 0.6rem;">{rankLabel}</span>
            <span style={"font-family:var(--font-body); font-size:0.72rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:white; background:" + badgeColor + "; border-radius:999px; padding:0.2rem 0.75rem;"}>{badge}</span>
          </div>
          <ToolCard tool={tool} rank={index + 1} />
        </div>
      ))}
    </div>

    <!-- See all reviews link -->
    <div style="text-align:center; margin-top:2rem;">
      <a href="/reviews/digitail" style="font-family:var(--font-body); font-size:0.9rem; font-weight:600; color:#0d9488; text-decoration:none;">
        See all {allTools.length} software reviews →
      </a>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════
       BROWSE BY CATEGORY
  ═══════════════════════════════════════════════════════════ -->
  <section style="background:#f5f5f4; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:4.5rem; padding-bottom:4.5rem;">

      <SectionHeader
        label="Browse by Category"
        title="Find software for your situation"
        subtitle="Whether you're a startup clinic or a multi-location hospital, we have a guide for you."
        align="center"
      />

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1rem; margin-top:2.5rem;">
        <CategoryCard
          href="/best/best-veterinary-software-for-small-practices"
          emoji="🐾"
          title="Best for Small Practices"
          description="1–3 vets, tight budget, need something simple that just works."
          count="5 tools"
        />
        <CategoryCard
          href="/best/best-veterinary-software-with-ai"
          emoji="🤖"
          title="Best AI Vet Software"
          description="AI SOAP notes, smart charge capture, and automation-first workflows."
          count="4 tools"
        />
        <CategoryCard
          href="/best/best-cloud-based-veterinary-software"
          emoji="☁️"
          title="Best Cloud-Based"
          description="Work from anywhere. No server maintenance. Automatic updates."
          count="8 tools"
        />
        <CategoryCard
          href="/best/best-veterinary-software-for-multi-location"
          emoji="🏥"
          title="Best for Multi-Location"
          description="Centralized billing, shared inventory, and consolidated reporting."
          count="5 tools"
        />
        <CategoryCard
          href="/best/best-veterinary-software-for-emergency-clinics"
          emoji="🚨"
          title="Best for Emergency Clinics"
          description="24/7 workflows, ICU boards, triage tools, and fast data entry."
          count="3 tools"
        />
        <CategoryCard
          href="/guides/how-to-choose-veterinary-software"
          emoji="📋"
          title="How to Choose a PIMS"
          description="Our complete buyer's guide for first-time and switching practices."
          count="Free guide"
        />
      </div>

      <!-- Quick comparison links -->
      <div style="margin-top:2.5rem; background:white; border:1px solid #e7e5e4; border-radius:12px; padding:1.5rem 2rem;">
        <p style="font-family:var(--font-body); font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:#0d9488; margin:0 0 1rem;">Popular comparisons</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
          {[
            { label: "Digitail vs ezyVet", slug: "digitail-vs-ezyvet" },
            { label: "Digitail vs Shepherd", slug: "digitail-vs-shepherd" },
            { label: "ezyVet vs Vetspire", slug: "ezyvet-vs-vetspire" },
            { label: "Shepherd vs Hippo Manager", slug: "shepherd-vs-hippo-manager" },
            { label: "DaySmart vs Hippo Manager", slug: "daysmart-vet-vs-hippo-manager" },
            { label: "ezyVet vs Cornerstone", slug: "ezyvet-vs-cornerstone" },
          ].map((comp) => (
            <a href={"/compare/" + comp.slug} style="font-family:var(--font-body); font-size:0.8rem; font-weight:600; color:#1e3d6f; background:#eef3fb; border:1px solid #b9d0ef; border-radius:999px; padding:0.3rem 0.85rem; text-decoration:none; transition:background 0.15s, border-color 0.15s;" onmouseover="this.style.background='#dce8f7';" onmouseout="this.style.background='#eef3fb';">
              {comp.label}
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       REVENUE CALCULATOR CTA
  ═══════════════════════════════════════════════════════════ -->
  <section class="container-wide" style="padding-top:4.5rem; padding-bottom:4.5rem;">
    <div style="background:linear-gradient(135deg,#0a1628 0%,#1e3d6f 100%); border-radius:16px; padding:3rem 2.5rem; display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center;">
      <div>
        <div style="display:inline-block; font-family:var(--font-body); font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#2dd4bf; margin-bottom:0.75rem;">Free Tool</div>
        <h2 style="font-family:var(--font-heading); font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:white; margin:0 0 0.75rem;">How much is your no-show rate costing you?</h2>
        <p style="font-family:var(--font-body); font-size:0.9375rem; color:#b9d0ef; margin:0; line-height:1.65;">Enter your practice details and get an instant revenue estimate, no-show loss breakdown, and personalized software recommendations.</p>
      </div>
      <div style="flex-shrink:0;">
        <a href="/tools/revenue-calculator" class="btn-primary" style="white-space:nowrap; padding:1rem 1.75rem; font-size:0.9375rem;">
          Try the Calculator
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" style="width:18px;height:18px;">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l3.158-2.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       NEWSLETTER — DARK EMAIL CAPTURE
  ═══════════════════════════════════════════════════════════ -->
  <section style="margin:0 -1.5rem; padding:0 1.5rem;">
    <EmailCapture variant="dark" />
  </section>

</BaseLayout>

<style>
  /* Responsive hero CTA stack on mobile */
  @media (max-width: 480px) {
    section a[href="/compare/digitail-vs-ezyvet"] {
      width: 100%;
      justify-content: center;
    }
  }
  /* Calculator CTA responsive */
  @media (max-width: 640px) {
    section > div[style*="grid-template-columns:1fr auto"] {
      grid-template-columns: 1fr;
    }
  }
</style>
