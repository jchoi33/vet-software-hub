---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getAllActiveTools, getPricingDisplay } from "../../utils/tools";

const allTools = getAllActiveTools();

// Group by pricing tier — same logic as pricing/[slug].astro
const freeTierTools = allTools.filter((t) => t.free_plan);
const budgetTools = allTools.filter((t) => !t.free_plan && t.starting_price_monthly !== null && t.starting_price_monthly <= 100);
const midRangeTools = allTools.filter((t) => !t.free_plan && t.starting_price_monthly !== null && t.starting_price_monthly > 100 && t.starting_price_monthly <= 200);
const premiumTools = allTools.filter((t) => !t.free_plan && t.starting_price_monthly !== null && t.starting_price_monthly > 200);
const customTools = allTools.filter((t) => !t.free_plan && t.starting_price_monthly === null);

type TierGroup = {
  label: string;
  sublabel: string;
  badgeBg: string;
  badgeColor: string;
  sectionBg: string;
  tools: ReturnType<typeof buildToolCards>;
};

function buildToolCards(tools: typeof allTools) {
  return tools
    .sort((a, b) => (a.starting_price_monthly ?? 9999) - (b.starting_price_monthly ?? 9999))
    .map((tool) => ({
      tool,
      pricingDisplay: getPricingDisplay(tool),
      pricingHref: "/pricing/" + tool.slug,
      priceNum: tool.starting_price_monthly !== null ? "$" + tool.starting_price_monthly : "Custom",
      initial: tool.name.charAt(0).toUpperCase(),
    }));
}

const tierGroups: TierGroup[] = [
  {
    label: "Free Plan Available",
    sublabel: "Get started at no cost",
    badgeBg: "#f0fdfa",
    badgeColor: "#0f766e",
    sectionBg: "white",
    tools: buildToolCards(freeTierTools),
  },
  {
    label: "Budget",
    sublabel: "Up to $100/month",
    badgeBg: "#f0fdf4",
    badgeColor: "#15803d",
    sectionBg: "#f2f5ef",
    tools: buildToolCards(budgetTools),
  },
  {
    label: "Mid-Range",
    sublabel: "$101–$200/month",
    badgeBg: "#fffbeb",
    badgeColor: "#b45309",
    sectionBg: "white",
    tools: buildToolCards(midRangeTools),
  },
  {
    label: "Premium",
    sublabel: "$200+/month",
    badgeBg: "#fef2f2",
    badgeColor: "#991b1b",
    sectionBg: "#f2f5ef",
    tools: buildToolCards(premiumTools),
  },
  {
    label: "Custom Pricing",
    sublabel: "Contact for a quote",
    badgeBg: "#eef3fb",
    badgeColor: "#1e3d6f",
    sectionBg: "white",
    tools: buildToolCards(customTools),
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Veterinary Software Pricing",
  description: "Transparent pricing breakdowns for every major veterinary PIMS. Compare plans across all price tiers.",
  url: "https://vetsoftwares.com/pricing",
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://vetsoftwares.com" },
      { "@type": "ListItem", position: 2, name: "Pricing", item: "https://vetsoftwares.com/pricing" },
    ],
  },
};
---

<BaseLayout
  title="Veterinary Software Pricing 2026 — Plans, Costs & Breakdowns | VetSoftwares"
  description={"Compare pricing for " + allTools.length + " veterinary practice management software platforms. Budget, mid-range, premium, and custom pricing tiers. Updated February 2026."}
  canonical="https://vetsoftwares.com/pricing"
  schema={schema}
>

  <!-- ═══ PAGE BANNER ═══ -->
  <section style="background:#1a2416; border-bottom:1px solid #2d3d26; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:2rem; padding-bottom:2rem;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap;">

        <!-- Left: breadcrumb + title + subtitle -->
        <div style="flex:1; min-width:0;">
          <nav style="margin-bottom:0.625rem;">
            <ol style="display:inline-flex; align-items:center; gap:0.4rem; list-style:none; padding:0; margin:0; font-family:var(--font-body); font-size:0.75rem; color:#5a7a4a;">
              <li><a href="/" style="color:#5a7a4a; text-decoration:none; transition:color 0.15s;" onmouseover="this.style.color='#9aba82';" onmouseout="this.style.color='#5a7a4a';">Home</a></li>
              <li style="color:#3a4f34;">/</li>
              <li style="color:#c4d5b7; font-weight:600;">Pricing</li>
            </ol>
          </nav>
          <h1 style="font-family:var(--font-heading); font-size:clamp(1.375rem,3vw,1.875rem); font-weight:800; color:white; line-height:1.2; margin:0 0 0.5rem;">
            Veterinary Software Pricing
          </h1>
          <p style="font-family:var(--font-body); font-size:0.9375rem; color:#8aab72; line-height:1.6; margin:0; max-width:520px;">
            Transparent pricing breakdowns for every major PIMS, from free plans to enterprise custom quotes. No affiliate bias in our rankings.
          </p>
        </div>

        <!-- Right: stats -->
        <div style="display:flex; gap:0.75rem; flex-shrink:0; flex-wrap:wrap;">
          {[
            { stat: String(allTools.length), label: "Tools Compared" },
            { stat: "5", label: "Price Tiers" },
            { stat: "2026", label: "Data Current" },
          ].map((item) => (
            <div style="background:rgba(255,255,255,0.05); border:1px solid #2d3d26; border-radius:10px; padding:0.625rem 1rem; text-align:center; min-width:90px;">
              <div style="font-family:var(--font-mono); font-size:1.25rem; font-weight:700; color:#fbbf24; line-height:1;">{item.stat}</div>
              <div style="font-family:var(--font-body); font-size:0.68rem; color:#5a7a4a; margin-top:0.2rem; font-weight:500; text-transform:uppercase; letter-spacing:0.04em;">{item.label}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ PRICING DISCLAIMER ═══ -->
  <section class="container-wide" style="padding-top:2rem;">
    <div style="background:#fffbeb; border:1px solid #fde68a; border-radius:10px; padding:1rem 1.25rem; display:flex; align-items:flex-start; gap:0.75rem;">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#d97706" style="width:18px;height:18px;flex-shrink:0;margin-top:1px;">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
      </svg>
      <p style="font-family:var(--font-body); font-size:0.8375rem; color:#92400e; margin:0; line-height:1.6;">
        <strong>Pricing changes frequently.</strong> All prices shown reflect publicly available starting rates as of February 2026. Always verify current pricing directly with each vendor before making a purchase decision.
      </p>
    </div>
  </section>

  <!-- ═══ TIERED PRICING SECTIONS ═══ -->
  {tierGroups.map(({ label, sublabel, badgeBg, badgeColor, sectionBg, tools }) => tools.length > 0 && (
    <section style={"background:" + sectionBg + "; margin:0 -1.5rem; padding:0 1.5rem;"}>
      <div class="container-wide" style="padding-top:3.5rem; padding-bottom:3.5rem;">

        <!-- Tier heading -->
        <div style="display:flex; align-items:center; gap:0.875rem; margin-bottom:1.75rem;">
          <span style={"font-family:var(--font-body); font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; background:" + badgeBg + "; color:" + badgeColor + "; border-radius:999px; padding:0.35rem 1rem; border:1px solid " + badgeBg + ";"}>
            {label}
          </span>
          <span style="font-family:var(--font-body); font-size:0.875rem; color:#78716c;">{sublabel}</span>
        </div>

        <!-- Tool cards -->
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1rem;">
          {tools.map(({ tool, pricingDisplay, pricingHref, priceNum, initial }) => (
            <a
              href={pricingHref}
              style="display:flex; align-items:center; gap:1rem; background:white; border:1px solid #dde5d5; border-radius:12px; padding:1.125rem 1.25rem; text-decoration:none; transition:box-shadow 0.2s, border-color 0.2s, transform 0.2s;"
              onmouseover="this.style.boxShadow='0 8px 24px rgba(0,0,0,0.08)';this.style.borderColor='#c4d5b7';this.style.transform='translateY(-2px)';"
              onmouseout="this.style.boxShadow='none';this.style.borderColor='#dde5d5';this.style.transform='none';"
            >
              <!-- Avatar -->
              <div style="width:40px; height:40px; background:#f2f5ef; border:1px solid #c4d5b7; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <span style="font-family:var(--font-heading); font-size:1.125rem; font-weight:700; color:#344a2b;">{initial}</span>
              </div>

              <!-- Info -->
              <div style="min-width:0; flex:1;">
                <div style="font-family:var(--font-heading); font-size:0.9375rem; font-weight:700; color:#1a2416; margin-bottom:0.2rem;">{tool.name}</div>
                <div style="font-family:var(--font-mono); font-size:0.8rem; font-weight:600; color:#466c34;">{pricingDisplay}</div>
                {tool.free_trial && (
                  <div style="font-family:var(--font-body); font-size:0.7rem; color:#466c34; margin-top:0.2rem;">✓ Free trial available</div>
                )}
              </div>

              <!-- Arrow -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" style="width:16px;height:16px;color:#a8b9a0;flex-shrink:0;">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L11.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.04-1.08l3.158-2.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
              </svg>
            </a>
          ))}
        </div>

      </div>
    </section>
  ))}

  <!-- ═══ NEWSLETTER ═══ -->
  <section style="margin:0 -1.5rem; padding:0 1.5rem;">
    <EmailCapture variant="dark" />
  </section>

</BaseLayout>
