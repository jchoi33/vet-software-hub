---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getAllActiveTools, getAverageRating, getPricingDisplay } from "../../utils/tools";

const allTools = getAllActiveTools();
const sortedTools = [...allTools].sort((a, b) => a.name.localeCompare(b.name));

// Pre-compute all card data to avoid template literal issues in JSX
const toolCards = sortedTools.map((tool) => {
  const avg = getAverageRating(tool);
  const fullStars = avg ? Math.floor(avg) : 0;
  const hasHalf = avg ? avg - fullStars >= 0.5 : false;
  const stars = "★".repeat(fullStars) + (hasHalf ? "½" : "") + "☆".repeat(5 - fullStars - (hasHalf ? 1 : 0));
  return {
    tool,
    initial: tool.name.charAt(0).toUpperCase(),
    avgRating: avg,
    starsStr: stars,
    pricingDisplay: getPricingDisplay(tool),
    reviewHref: "/reviews/" + tool.slug,
  };
});

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Veterinary Software Reviews",
  description: "Independent reviews of " + allTools.length + " veterinary practice management software platforms.",
  url: "https://vetsoftwares.com/reviews",
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://vetsoftwares.com" },
      { "@type": "ListItem", position: 2, name: "Reviews", item: "https://vetsoftwares.com/reviews" },
    ],
  },
};
---

<BaseLayout
  title={"All Veterinary Software Reviews 2026 — " + allTools.length + " PIMS Tested | VetSoftwares"}
  description={"Independent reviews of " + allTools.length + " veterinary practice management software platforms. Compare pricing, features, ratings, and get honest recommendations."}
  canonical="https://vetsoftwares.com/reviews"
  schema={schema}
>

  <!-- ═══ PAGE BANNER ═══ -->
  <section style="background:#1a2416; border-bottom:1px solid #2d3d26; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:2rem; padding-bottom:2rem;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap;">

        <!-- Left: breadcrumb + title + subtitle -->
        <div style="flex:1; min-width:0;">
          <nav style="margin-bottom:0.625rem;">
            <ol style="display:inline-flex; align-items:center; gap:0.4rem; list-style:none; padding:0; margin:0; font-family:var(--font-body); font-size:0.75rem; color:#5a7a4a;">
              <li><a href="/" style="color:#5a7a4a; text-decoration:none; transition:color 0.15s;" onmouseover="this.style.color='#9aba82';" onmouseout="this.style.color='#5a7a4a';">Home</a></li>
              <li style="color:#3a4f34;">/</li>
              <li style="color:#c4d5b7; font-weight:600;">Reviews</li>
            </ol>
          </nav>
          <h1 style="font-family:var(--font-heading); font-size:clamp(1.375rem,3vw,1.875rem); font-weight:800; color:white; line-height:1.2; margin:0 0 0.5rem;">
            All Veterinary Software Reviews
          </h1>
          <p style="font-family:var(--font-body); font-size:0.9375rem; color:#8aab72; line-height:1.6; margin:0; max-width:520px;">
            We independently test and evaluate every major PIMS on the market. Zero vendor influence. Real data from G2 and Capterra.
          </p>
        </div>

        <!-- Right: stats -->
        <div style="display:flex; gap:0.75rem; flex-shrink:0; flex-wrap:wrap;">
          {[
            { stat: String(allTools.length), label: "Tools Reviewed" },
            { stat: "100%", label: "Independent" },
            { stat: "2026", label: "Data Current" },
          ].map((item) => (
            <div style="background:rgba(255,255,255,0.05); border:1px solid #2d3d26; border-radius:10px; padding:0.625rem 1rem; text-align:center; min-width:90px;">
              <div style="font-family:var(--font-mono); font-size:1.25rem; font-weight:700; color:#fbbf24; line-height:1;">{item.stat}</div>
              <div style="font-family:var(--font-body); font-size:0.68rem; color:#5a7a4a; margin-top:0.2rem; font-weight:500; text-transform:uppercase; letter-spacing:0.04em;">{item.label}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ REVIEWS GRID ═══ -->
  <section style="background:#f2f5ef; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:4rem; padding-bottom:4.5rem;">

      <SectionHeader
        label="All Reviews"
        title="Every Veterinary PIMS, Evaluated"
        subtitle="Sorted alphabetically. Every tool scored on features, pricing, support, and real user ratings."
        align="center"
      />

      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1rem; margin-top:2.5rem;">
        {toolCards.map(({ tool, initial, avgRating, starsStr, pricingDisplay, reviewHref }) => (
          <a
            href={reviewHref}
            style="display:flex; align-items:flex-start; gap:1rem; background:white; border:1px solid #dde5d5; border-radius:12px; padding:1.25rem; text-decoration:none; transition:box-shadow 0.2s, border-color 0.2s, transform 0.2s;"
            onmouseover="this.style.boxShadow='0 8px 24px rgba(0,0,0,0.08)';this.style.borderColor='#c4d5b7';this.style.transform='translateY(-2px)';"
            onmouseout="this.style.boxShadow='none';this.style.borderColor='#dde5d5';this.style.transform='none';"
          >
            <!-- Avatar -->
            <div style="width:44px; height:44px; background:#f2f5ef; border:1px solid #c4d5b7; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <span style="font-family:var(--font-heading); font-size:1.25rem; font-weight:700; color:#344a2b;">{initial}</span>
            </div>

            <!-- Content -->
            <div style="min-width:0; flex:1;">
              <div style="font-family:var(--font-heading); font-size:1rem; font-weight:700; color:#0a1628; margin-bottom:0.2rem;">{tool.name}</div>
              <div style="font-family:var(--font-body); font-size:0.775rem; color:#78716c; font-style:italic; margin-bottom:0.5rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{tool.tagline}</div>

              {avgRating && (
                <div style="display:flex; align-items:center; gap:0.375rem; margin-bottom:0.35rem;">
                  <span style="color:#f59e0b; font-size:0.75rem; letter-spacing:0.02em;">{starsStr}</span>
                  <span style="font-family:var(--font-mono); font-size:0.75rem; font-weight:600; color:#57534e;">{avgRating.toFixed(1)}</span>
                </div>
              )}

              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="font-family:var(--font-mono); font-size:0.775rem; font-weight:600; color:#344a2b;">{pricingDisplay}</span>
                <span style="font-family:var(--font-body); font-size:0.775rem; font-weight:600; color:#466c34;">Read Review →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section style="margin:0 -1.5rem; padding:0 1.5rem;">
    <EmailCapture variant="dark" />
  </section>

</BaseLayout>
