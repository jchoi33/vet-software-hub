---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getAllTools, getAverageRating, getPricingDisplay } from "../../utils/tools";

const allTools = getAllTools();
const sortedTools = [...allTools].sort((a, b) => a.name.localeCompare(b.name));

// Pre-compute all card data to avoid template literal issues in JSX
const toolCards = sortedTools.map((tool) => {
  const avg = getAverageRating(tool);
  const fullStars = avg ? Math.floor(avg) : 0;
  const hasHalf = avg ? avg - fullStars >= 0.5 : false;
  const stars = "★".repeat(fullStars) + (hasHalf ? "½" : "") + "☆".repeat(5 - fullStars - (hasHalf ? 1 : 0));
  return {
    tool,
    initial: tool.name.charAt(0).toUpperCase(),
    avgRating: avg,
    starsStr: stars,
    pricingDisplay: getPricingDisplay(tool),
    reviewHref: "/reviews/" + tool.slug,
  };
});

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Veterinary Software Reviews",
  description: "Independent reviews of " + allTools.length + " veterinary practice management software platforms.",
  url: "https://vetsoftwares.com/reviews",
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://vetsoftwares.com" },
      { "@type": "ListItem", position: 2, name: "Reviews", item: "https://vetsoftwares.com/reviews" },
    ],
  },
};
---

<BaseLayout
  title={"All Veterinary Software Reviews 2026 — " + allTools.length + " PIMS Tested | VetSoftwares"}
  description={"Independent reviews of " + allTools.length + " veterinary practice management software platforms. Compare pricing, features, ratings, and get honest recommendations."}
  canonical="https://vetsoftwares.com/reviews"
  schema={schema}
>

  <!-- ═══ HERO ═══ -->
  <section style="background:linear-gradient(135deg,#0a1628 0%,#162d54 60%,#0f2140 100%); margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:4rem; padding-bottom:4rem; text-align:center;">

      <!-- Breadcrumb -->
      <nav style="margin-bottom:1.5rem;">
        <ol style="display:inline-flex; align-items:center; gap:0.5rem; list-style:none; padding:0; margin:0; font-family:var(--font-body); font-size:0.8rem; color:#6b90c8;">
          <li><a href="/" style="color:#6b90c8; text-decoration:none;">Home</a></li>
          <li style="opacity:0.5;">/</li>
          <li style="color:#b9d0ef; font-weight:600;">Reviews</li>
        </ol>
      </nav>

      <!-- Badge -->
      <div style="display:inline-flex; align-items:center; gap:0.5rem; background:rgba(45,212,191,0.12); border:1px solid rgba(45,212,191,0.3); border-radius:999px; padding:0.35rem 1rem; margin-bottom:1.5rem;">
        <span style="font-family:var(--font-body); font-size:0.72rem; font-weight:700; letter-spacing:0.06em; color:#2dd4bf; text-transform:uppercase;">Updated February 2026</span>
      </div>

      <h1 style="font-family:var(--font-heading); font-size:clamp(1.75rem,4vw,3rem); font-weight:900; color:white; line-height:1.2; margin:0 auto 1rem; max-width:700px;">
        All Veterinary Software Reviews
      </h1>
      <p style="font-family:var(--font-body); font-size:1.0625rem; color:#b9d0ef; line-height:1.7; max-width:560px; margin:0 auto 2.5rem;">
        We independently test and evaluate every major PIMS on the market. Zero vendor influence. Real data from G2 and Capterra.
      </p>

      <!-- Stat cards -->
      <div style="display:inline-flex; gap:1rem; flex-wrap:wrap; justify-content:center;">
        {[
          { stat: String(allTools.length), label: "Tools Reviewed" },
          { stat: "100%", label: "Independent" },
          { stat: "2026", label: "Data Current" },
        ].map((item) => (
          <div style="background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.12); border-radius:12px; padding:0.875rem 1.25rem; text-align:center; min-width:110px;">
            <div style="font-family:var(--font-mono); font-size:1.5rem; font-weight:700; color:#2dd4bf; line-height:1;">{item.stat}</div>
            <div style="font-family:var(--font-body); font-size:0.72rem; color:#96b8e7; margin-top:0.25rem; font-weight:500;">{item.label}</div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ REVIEWS GRID ═══ -->
  <section style="background:#f5f5f4; margin:0 -1.5rem; padding:0 1.5rem;">
    <div class="container-wide" style="padding-top:4rem; padding-bottom:4.5rem;">

      <SectionHeader
        label="All Reviews"
        title="Every Veterinary PIMS, Evaluated"
        subtitle="Sorted alphabetically. Every tool scored on features, pricing, support, and real user ratings."
        align="center"
      />

      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1rem; margin-top:2.5rem;">
        {toolCards.map(({ tool, initial, avgRating, starsStr, pricingDisplay, reviewHref }) => (
          <a
            href={reviewHref}
            style="display:flex; align-items:flex-start; gap:1rem; background:white; border:1px solid #e7e5e4; border-radius:12px; padding:1.25rem; text-decoration:none; transition:box-shadow 0.2s, border-color 0.2s, transform 0.2s;"
            onmouseover="this.style.boxShadow='0 8px 24px rgba(0,0,0,0.08)';this.style.borderColor='#b9d0ef';this.style.transform='translateY(-2px)';"
            onmouseout="this.style.boxShadow='none';this.style.borderColor='#e7e5e4';this.style.transform='none';"
          >
            <!-- Avatar -->
            <div style="width:44px; height:44px; background:#eef3fb; border:1px solid #b9d0ef; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <span style="font-family:var(--font-heading); font-size:1.25rem; font-weight:700; color:#1e3d6f;">{initial}</span>
            </div>

            <!-- Content -->
            <div style="min-width:0; flex:1;">
              <div style="font-family:var(--font-heading); font-size:1rem; font-weight:700; color:#0a1628; margin-bottom:0.2rem;">{tool.name}</div>
              <div style="font-family:var(--font-body); font-size:0.775rem; color:#78716c; font-style:italic; margin-bottom:0.5rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{tool.tagline}</div>

              {avgRating && (
                <div style="display:flex; align-items:center; gap:0.375rem; margin-bottom:0.35rem;">
                  <span style="color:#f59e0b; font-size:0.75rem; letter-spacing:0.02em;">{starsStr}</span>
                  <span style="font-family:var(--font-mono); font-size:0.75rem; font-weight:600; color:#57534e;">{avgRating.toFixed(1)}</span>
                </div>
              )}

              <div style="display:flex; align-items:center; justify-content:space-between;">
                <span style="font-family:var(--font-mono); font-size:0.775rem; font-weight:600; color:#1e3d6f;">{pricingDisplay}</span>
                <span style="font-family:var(--font-body); font-size:0.775rem; font-weight:600; color:#0d9488;">Read Review →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section style="margin:0 -1.5rem; padding:0 1.5rem;">
    <EmailCapture variant="dark" />
  </section>

</BaseLayout>
